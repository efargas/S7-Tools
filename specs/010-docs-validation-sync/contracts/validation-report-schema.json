{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://s7tools.dev/schemas/validation-report.schema.json",
  "title": "S7Tools Documentation Validation Report",
  "description": "Schema for S7Tools documentation validation results",
  "type": "object",
  "required": [
    "generated_at",
    "validation_version",
    "total_files_checked",
    "total_errors",
    "total_warnings",
    "code_examples",
    "compilation_success_rate",
    "file_references",
    "file_reference_success_rate",
    "namespace_validations",
    "namespace_compliance_rate",
    "pattern_implementations",
    "pattern_verification_rate",
    "editorconfig_discrepancies",
    "broken_links",
    "execution_time_seconds",
    "summary"
  ],
  "properties": {
    "generated_at": {
      "type": "string",
      "format": "date-time",
      "description": "ISO 8601 timestamp of report generation"
    },
    "validation_version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$",
      "description": "Semantic version of validation script"
    },
    "total_files_checked": {
      "type": "integer",
      "minimum": 0,
      "description": "Number of documentation files validated"
    },
    "total_errors": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of errors found"
    },
    "total_warnings": {
      "type": "integer",
      "minimum": 0,
      "description": "Total count of warnings found"
    },
    "code_examples": {
      "type": "array",
      "description": "Extracted code examples and compilation results",
      "items": {
        "$ref": "#/definitions/CodeExample"
      }
    },
    "compilation_success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of code examples that compiled successfully"
    },
    "file_references": {
      "type": "array",
      "description": "File path references found in documentation",
      "items": {
        "$ref": "#/definitions/FilePathReference"
      }
    },
    "file_reference_success_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of file references that exist"
    },
    "namespace_validations": {
      "type": "array",
      "description": "Namespace convention validation results",
      "items": {
        "$ref": "#/definitions/NamespaceValidation"
      }
    },
    "namespace_compliance_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of namespaces following documented conventions"
    },
    "pattern_implementations": {
      "type": "array",
      "description": "Architectural pattern verification results",
      "items": {
        "$ref": "#/definitions/PatternImplementation"
      }
    },
    "pattern_verification_rate": {
      "type": "number",
      "minimum": 0,
      "maximum": 100,
      "description": "Percentage of patterns verified in documented locations"
    },
    "editorconfig_discrepancies": {
      "type": "array",
      "description": "Differences between .editorconfig and code-style.md",
      "items": {
        "$ref": "#/definitions/EditorConfigRule"
      }
    },
    "broken_links": {
      "type": "array",
      "description": "Internal documentation links that result in 404",
      "items": {
        "type": "object",
        "required": ["source_file", "target_path", "line_number"],
        "properties": {
          "source_file": { "type": "string" },
          "target_path": { "type": "string" },
          "line_number": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "execution_time_seconds": {
      "type": "number",
      "minimum": 0,
      "description": "Total validation execution time in seconds"
    },
    "summary": {
      "type": "string",
      "description": "Human-readable summary of validation results"
    }
  },
  "definitions": {
    "CodeExample": {
      "type": "object",
      "required": [
        "source_file",
        "line_number",
        "language",
        "code",
        "is_simplified"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "description": "Documentation file containing the example"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number where code block starts"
        },
        "language": {
          "type": "string",
          "enum": ["csharp", "python", "bash", "xml"],
          "description": "Programming language of example"
        },
        "code": {
          "type": "string",
          "minLength": 1,
          "description": "Extracted code content"
        },
        "context": {
          "type": "string",
          "description": "Surrounding text explaining the example"
        },
        "is_simplified": {
          "type": "boolean",
          "description": "Flag indicating simplified/incomplete example"
        },
        "required_usings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Required using statements for compilation"
        },
        "compilation_result": {
          "$ref": "#/definitions/CompilationResult"
        }
      }
    },
    "CompilationResult": {
      "type": "object",
      "required": [
        "success",
        "errors",
        "warnings",
        "execution_time_ms",
        "exit_code"
      ],
      "properties": {
        "success": {
          "type": "boolean",
          "description": "True if compilation succeeded"
        },
        "errors": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Compilation error messages"
        },
        "warnings": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Compilation warnings"
        },
        "execution_time_ms": {
          "type": "integer",
          "minimum": 0,
          "description": "Time taken to compile in milliseconds"
        },
        "exit_code": {
          "type": "integer",
          "description": "dotnet build exit code (0 = success)"
        }
      }
    },
    "FilePathReference": {
      "type": "object",
      "required": [
        "source_file",
        "line_number",
        "referenced_path",
        "path_type",
        "exists"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "description": "Documentation file containing the reference"
        },
        "line_number": {
          "type": "integer",
          "minimum": 1,
          "description": "Line number of reference"
        },
        "referenced_path": {
          "type": "string",
          "description": "The path mentioned in documentation"
        },
        "path_type": {
          "type": "string",
          "enum": ["absolute", "relative", "project_relative"],
          "description": "Type of path reference"
        },
        "exists": {
          "type": "boolean",
          "description": "True if path exists in repository"
        },
        "resolved_path": {
          "type": "string",
          "description": "Absolute resolved path (if exists)"
        }
      }
    },
    "NamespaceValidation": {
      "type": "object",
      "required": [
        "source_file",
        "declared_namespace",
        "expected_pattern",
        "is_compliant"
      ],
      "properties": {
        "source_file": {
          "type": "string",
          "description": "Source code file being validated"
        },
        "declared_namespace": {
          "type": "string",
          "description": "Namespace declared in source file"
        },
        "expected_pattern": {
          "type": "string",
          "description": "Expected pattern from documentation"
        },
        "category": {
          "type": "string",
          "enum": ["Base", "Controls", "Dialogs", "Jobs", "Layout", "Pages", "Profiles", "Settings", "Tasks"],
          "description": "Category for ViewModels/Views"
        },
        "is_compliant": {
          "type": "boolean",
          "description": "True if namespace matches expected pattern"
        },
        "violation_details": {
          "type": "string",
          "description": "Description of violation (if not compliant)"
        }
      }
    },
    "PatternImplementation": {
      "type": "object",
      "required": [
        "pattern_name",
        "documented_location",
        "expected_files",
        "found_files",
        "is_verified",
        "missing_files",
        "extra_files"
      ],
      "properties": {
        "pattern_name": {
          "type": "string",
          "enum": [
            "Unified Profile Management",
            "Internal Method Pattern",
            "Resource Coordination",
            "Custom Exceptions",
            "Reusable Controls"
          ],
          "description": "Name of architectural pattern"
        },
        "documented_location": {
          "type": "string",
          "description": "Where pattern is documented"
        },
        "expected_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files that should implement pattern"
        },
        "found_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Files actually found implementing pattern"
        },
        "is_verified": {
          "type": "boolean",
          "description": "True if pattern found as documented"
        },
        "missing_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Expected files not found"
        },
        "extra_files": {
          "type": "array",
          "items": { "type": "string" },
          "description": "Found files not documented"
        }
      }
    },
    "EditorConfigRule": {
      "type": "object",
      "required": [
        "section",
        "rule_name",
        "rule_value",
        "is_consistent"
      ],
      "properties": {
        "section": {
          "type": "string",
          "description": "File pattern (e.g., '*.cs', '*.axaml')"
        },
        "rule_name": {
          "type": "string",
          "description": "Rule identifier (e.g., 'indent_size')"
        },
        "rule_value": {
          "type": "string",
          "description": "Configured value (e.g., '4', 'true')"
        },
        "documented_value": {
          "type": "string",
          "description": "Value mentioned in docs/guides/code-style.md"
        },
        "is_consistent": {
          "type": "boolean",
          "description": "True if .editorconfig matches documentation"
        }
      }
    }
  }
}
