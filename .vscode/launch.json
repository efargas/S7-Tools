    "version": "0.2.0",
    "configurations": [
        {
            "name": "C#: S7Tools Debug",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: 2-build",
            "program": "${workspaceFolder}/src/S7Tools/bin/Debug/net8.0/S7Tools.dll",
            "args": [],
            "cwd": "${workspaceFolder}",
            "console": "integratedTerminal",
            "stopAtEntry": false
        },
        {
            "name": ".NET Meteor Debugger",
            "type": "dotnet-meteor.debugger",
            "request": "launch",
            "preLaunchTask": "dotnet-meteor: 2-Build",
            "program": "${workspaceFolder}/src/S7Tools/bin/Debug/net8.0/S7Tools.dll",
        },
        {
            "name": ".NET Core Launch (console)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "dotnet: 2-build",
            "program": "${workspaceFolder}/src/S7Tools/bin/Debug/net8.0/S7Tools.dll",
        }
    ]
}