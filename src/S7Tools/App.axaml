<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:S7Tools"
             xmlns:converters="using:S7Tools.Converters"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             xmlns:sty="using:FluentAvalonia.Styling"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             x:Class="S7Tools.App"
             RequestedThemeVariant="Default">
    <!-- "Default" ThemeVariant follows system theme variant. "Dark" or "Light" are other available options. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>

    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="/Theme/Colors.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Converters -->
            <converters:ModbusAddressingModeConverter x:Key="ModbusAddressingModeConverter" />
            <converters:DateTimeToStringConverter x:Key="DateTimeToStringConverter" />

        <ControlTheme x:Key="{x:Type GridSplitter}" TargetType="GridSplitter">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border Background="{TemplateBinding Background}">
                        <Border x:Name="PART_Divider"
                                Background="{DynamicResource ControlBorderBrush}"
                                BorderThickness="1"/>
                    </Border>
                </ControlTemplate>
            </Setter>
            <Style Selector="^:pointerover /template/ Border#PART_Divider, ^:pressed /template/ Border#PART_Divider">
                <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}"/>
            </Style>
            <Style Selector="^[ResizeDirection=Columns]">
                <Setter Property="Width" Value="5"/>
                <Style Selector="^ /template/ Border#PART_Divider">
                    <Setter Property="Width" Value="5"/>
                    <Setter Property="HorizontalAlignment" Value="Center"/>
                </Style>
            </Style>
            <Style Selector="^[ResizeDirection=Rows]">
                <Setter Property="Height" Value="5"/>
                <Style Selector="^ /template/ Border#PART_Divider">
                    <Setter Property="Height" Value="5"/>
                    <Setter Property="VerticalAlignment" Value="Center"/>
                </Style>
            </Style>
        </ControlTheme>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <sty:FluentAvaloniaTheme />
        <StyleInclude Source="avares://Dock.Avalonia.Themes.Fluent/DockFluentTheme.axaml"/>
        <StyleInclude Source="/Styles/Styles.axaml" />
        <StyleInclude Source="/Styles/DockStyles.axaml" />
        <StyleInclude Source="/Styles/InfoStyles.axaml" />
        <StyleInclude Source="/Styles/PropertyStyles.axaml" />

        <!-- Override FluentAvalonia's ToggleButton:checked accent color in Expanders -->
        <!-- This must come AFTER FluentAvaloniaTheme to have higher precedence -->
        <Style Selector="Expander ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Expander ToggleButton:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>

        <Style Selector="Expander ToggleButton:checked:pressed /template/ ContentPresenter#PART_ContentPresenter">
            <Setter Property="Background" Value="Transparent" />
        </Style>
    </Application.Styles>
</Application>
