<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:idc="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia">

    <!--
        Fix Dock.Avalonia button/icon rendering.
        
        Root Cause: The global Button style in Styles.axaml sets Background, BorderBrush,
        BorderThickness, CornerRadius, Padding, and FontSize on ALL buttons. This overrides
        Dock.Avalonia's small transparent icon buttons (close, pin, float, maximize) turning
        them into blue rectangles.
        
        Fix: Reset dock control buttons back to transparent defaults so the Dock theme's
        own PathIcon/geometry content renders correctly.
    -->

    <!-- === Generic Dock button resets for inner template buttons === -->
    <!-- Dock.Avalonia usually names its buttons #PART_CloseButton, #PART_PinButton, #PART_FloatButton -->
    <Style Selector="Button#PART_CloseButton, Button#PART_PinButton, Button#PART_FloatButton">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="Margin" Value="0"/>
        <Setter Property="MinWidth" Value="0"/>
        <Setter Property="MinHeight" Value="0"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}"/>
    </Style>

    <Style Selector="Button#PART_CloseButton:pointerover, Button#PART_PinButton:pointerover, Button#PART_FloatButton:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}"/>
    </Style>

    <Style Selector="Button#PART_CloseButton:pressed, Button#PART_PinButton:pressed, Button#PART_FloatButton:pressed">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}"/>
    </Style>

    <!-- Sometimes Dock plugins use PathIcon directly inside a generic transparent button template. Let's make sure the host buttons nested inside any Dock control reset their borders -->
    <Style Selector="idc|DocumentTabStripItem Button, idc|ToolTabStripItem Button, idc|ToolChromeControl Button">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Padding" Value="4"/>
        <Setter Property="CornerRadius" Value="3"/>
        <Setter Property="Height" Value="24"/>
        <Setter Property="Width" Value="24"/>
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}"/>
    </Style>

    <Style Selector="idc|DocumentTabStripItem Button PathIcon, idc|ToolTabStripItem Button PathIcon, idc|ToolChromeControl Button PathIcon, Button#PART_CloseButton PathIcon, Button#PART_PinButton PathIcon, Button#PART_FloatButton PathIcon">
        <Setter Property="Width" Value="12"/>
        <Setter Property="Height" Value="12"/>
    </Style>

    <Style Selector="idc|DocumentTabStripItem Button:pointerover, idc|ToolTabStripItem Button:pointerover, idc|ToolChromeControl Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="BorderBrush" Value="Transparent"/>
        <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}"/>
    </Style>


</Styles>
