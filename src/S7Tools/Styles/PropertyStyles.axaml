
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:icons="using:Projektanker.Icons.Avalonia">

  <!-- Port Discovery Card Style (matches mockup) -->
  <Style Selector="Border.PortCard">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="10,8" />
    <Setter Property="Width" Value="160" />
    <Setter Property="Height" Value="60" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="HorizontalAlignment" Value="Stretch" />
  </Style>

  <!-- Property card layout styles for profile detail views -->

  <!-- ItemsControl content presenter styling for property cards -->
  <Style Selector="ItemsControl.PropertyCards > ContentPresenter">
    <Setter Property="Width" Value="280" />
    <Setter Property="Margin" Value="0,0,12,8" />
  </Style>

  <!-- Property card container styling -->
  <Style Selector="Border.PropertyItem">
    <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="3" />
    <Setter Property="Padding" Value="8,6" />
  </Style>

  <!-- Property label styling (blue, smaller, bold) -->
  <Style Selector="TextBlock.PropertyLabel">
    <Setter Property="Foreground" Value="{DynamicResource BrandAccentBrush}" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="TextWrapping" Value="NoWrap" />
  </Style>

  <!-- Property value styling (gray, larger, normal) -->
  <Style Selector="TextBlock.PropertyValue">
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="Margin" Value="0,2,0,0" />
  </Style>

  <!-- Section borders - VS Code style -->
  <Style Selector="Border.ProfileSection">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="1,1,1,1" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Transitions" Value="" />
  </Style>

  <!-- Override profile section grid and children -->
  <Style Selector="Border.ProfileSection Expander Grid">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.ProfileSection Expander Grid icons|Icon">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.ProfileSection Expander Grid TextBlock">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.ProfileSection Expander ToggleButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.ProfileSection Expander ToggleButton ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.WarningSection">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    <Setter Property="BorderThickness" Value="0,1,0,0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Transitions" Value="" />
  </Style>

  <!-- Override warning section grid and children -->
  <Style Selector="Border.WarningSection Expander Grid">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.WarningSection Expander Grid icons|Icon">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.WarningSection Expander Grid TextBlock">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.WarningSection Expander ToggleButton">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <Style Selector="Border.WarningSection Expander ToggleButton ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- Complete Expander template override -->
  <Style Selector="Expander">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Transitions" Value="" />
    <Setter Property="Template">
      <ControlTemplate>
        <StackPanel Transitions="">
          <!-- Header -->
          <ToggleButton Name="PART_Toggle"
                       IsChecked="{TemplateBinding IsExpanded, Mode=TwoWay}"
                       HorizontalAlignment="Stretch"
                       HorizontalContentAlignment="Stretch"
                       VerticalContentAlignment="Center"
                       MinHeight="0"
                       Padding="2,2"
                       Background="Transparent"
                       BorderThickness="0"
                       Content="{TemplateBinding Header}"
                       ContentTemplate="{TemplateBinding HeaderTemplate}"
                       Transitions="">
            <ToggleButton.Template>
              <ControlTemplate>
                <ContentPresenter Name="PART_ContentPresenter"
                                 Background="Transparent"
                                 Content="{TemplateBinding Content}"
                                 ContentTemplate="{TemplateBinding ContentTemplate}"
                                 Padding="{TemplateBinding Padding}"
                                 HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                 VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" />
              </ControlTemplate>
            </ToggleButton.Template>
          </ToggleButton>

          <!-- Content -->
          <ContentPresenter Name="PART_ContentPresenter"
                           IsVisible="{TemplateBinding IsExpanded}"
                           Content="{TemplateBinding Content}"
                           ContentTemplate="{TemplateBinding ContentTemplate}"
                           Padding="0,0"
                           Transitions="" />
        </StackPanel>
      </ControlTemplate>
    </Setter>
  </Style>

  <!-- Header text styling -->
  <Style Selector="TextBlock.ExpanderHeader">
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Icon styling -->
  <Style Selector="icons|Icon.ExpanderIcon">
    <Setter Property="Width" Value="12" />
    <Setter Property="Height" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="4,0,4,0" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- Arrow icon states -->
  <Style Selector="Expander:not(:expanded) icons|Icon.ExpanderArrow">
    <Setter Property="Value" Value="fa-solid fa-chevron-right" />
  </Style>

  <Style Selector="Expander:expanded icons|Icon.ExpanderArrow">
    <Setter Property="Value" Value="fa-solid fa-chevron-down" />
  </Style>

</Styles>
