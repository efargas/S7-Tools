<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="using:FluentAvalonia.UI.Controls"
        xmlns:views="clr-namespace:S7Tools.Views"
        xmlns:viewsPages="clr-namespace:S7Tools.Views.Pages">
    <Style Selector="ui|NavigationViewItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
    </Style>
    <Style Selector="ui|NavigationViewItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>
    <Style Selector="ui|NavigationViewItem:selected Border#AccentRectangle">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ui|NavigationViewItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>

    <Style Selector="ui|NavigationViewItem Image">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="0,0,0,5" />
    </Style>

    <Style Selector="ui|NavigationView Grid#PaneContentGrid">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    </Style>

    <!-- GridSplitter Styles for VSCode-like appearance -->
    <Style Selector="GridSplitter">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="GridSplitter:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}" />
    </Style>

    <Style Selector="GridSplitter:dragging">
        <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}" />
    </Style>

    <Style Selector="TabItem">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundMutedBrush}" />
    </Style>

    <Style Selector="TabItem:selected">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>

    <Style Selector="TabItem:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>

    <!-- Smooth transitions for panel animations -->
    <Style Selector="Border.panel-content">
        <Setter Property="Transitions">
            <Transitions>
                <DoubleTransition Property="Opacity" Duration="0:0:0.2" />
            </Transitions>
        </Setter>
    </Style>

    <!-- Grid transitions for smooth resizing -->
    <Style Selector="Grid">
        <Setter Property="Transitions">
            <Transitions>
                <ThicknessTransition Property="Margin" Duration="0:0:0.15" />
            </Transitions>
        </Setter>
    </Style>

    <!-- DatePicker Styles for dark theme -->
    <Style Selector="DatePicker">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="DatePicker:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}" />
    </Style>

    <Style Selector="DatePicker:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}" />
    </Style>

    <!-- DatePicker Button Styles -->
    <Style Selector="DatePicker Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <Style Selector="DatePicker Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>

    <!-- ComboBox Styles for consistency -->
    <Style Selector="ComboBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="ComboBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}" />
    </Style>

    <Style Selector="ComboBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}" />
    </Style>

    <!-- TextBox Styles for consistency -->
    <Style Selector="TextBox">
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="SelectionBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextForegroundSecondaryBrush}" />
    </Style>

    <Style Selector="TextBox:pointerover">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}" />
    </Style>

    <Style Selector="TextBox:focus">
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource ControlBackgroundPointerOverBrush}" />
    </Style>

    <!-- Button Styles for consistency -->
    <Style Selector="Button">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Button:pointerover">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackgroundPointerOverBrush}" />
    </Style>

    <Style Selector="Button:pressed">
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBackgroundPressedBrush}" />
    </Style>

    <!-- Transparent Button Override -->
    <Style Selector="Button.transparent">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
    </Style>

    <Style Selector="Button.compact">
        <Setter Property="MinHeight" Value="20" />
        <Setter Property="Padding" Value="4,0" />
        <Setter Property="FontSize" Value="10" />
    </Style>

    <Style Selector="viewsPages|LogViewerView TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="viewsPages|LogViewerView ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="viewsPages|LogViewerView DatePicker">
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="viewsPages|LogViewerView Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="viewsPages|LogViewerView ToggleButton">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!-- spin style removed: apply animations per-control or use ProgressRing for large scanning indicator -->
</Styles>
