<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Pages"
             xmlns:hex="using:S7Tools.Views.Hex"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="S7Tools.Views.Pages.FileMemoryDumpDocumentView"
             x:DataType="vm:FileMemoryDumpDocumentViewModel">

    <Grid ColumnDefinitions="*, 300">
        <!-- Main Hex Grid (Left) -->
        <hex:HexViewerControl Grid.Column="0" DataContext="{Binding HexViewer}" />

        <!-- Data Inspector (Right) -->
        <Border Grid.Column="1" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1,0,0,0"
                Background="{DynamicResource PanelBackgroundBrush}">
            <hex:DataInspectorView DataContext="{Binding HexViewer.DataInspector}" />
        </Border>
    </Grid>

</UserControl>
