<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:S7Tools.ViewModels.Pages"
    xmlns:views="using:S7Tools.Views.Pages"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
    x:Class="S7Tools.Views.Pages.MemoryDumpViewerView"
    x:DataType="vm:MemoryDumpViewerViewModel"
    Background="{DynamicResource AppBackgroundBrush}">

    <ContentControl Content="{Binding SelectedCategoryViewModel}">
        <ContentControl.DataTemplates>
            <DataTemplate DataType="vm:StreamedMemoryDumpViewModel">
                <views:StreamedMemoryDumpView />
            </DataTemplate>
        </ContentControl.DataTemplates>
    </ContentControl>
</UserControl>