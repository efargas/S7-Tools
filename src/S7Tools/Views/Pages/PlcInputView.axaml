<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Pages"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="S7Tools.Views.Pages.PlcInputView"
             x:DataType="vm:PlcInputViewModel"
             Background="{DynamicResource AppBackgroundBrush}">
  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="16">
      <!-- Title -->
      <TextBlock Text="PLC Diagnostics"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                 Margin="0,0,0,10" />

      <!-- Validation Section -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-network-wired" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="PLC CONNECTION VALIDATION" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="20" Margin="24,16,24,24">
            <TextBlock Text="Identify and verify the availability of a Siemens S7 PLC on the local or remote network."
                       FontSize="13"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       TextWrapping="Wrap" />

            <StackPanel Spacing="8">
              <TextBlock Text="PLC Network Address:" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextForegroundSecondaryBrush}"/>
              <TextBox Text="{Binding Address, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                       Watermark="Enter IP address (e.g. 192.168.0.10)"
                       Width="350" HorizontalAlignment="Left"
                       Padding="12,8"/>
            </StackPanel>

            <Button Command="{Binding ValidateCommand}" 
                    Background="{DynamicResource BrandAccentBrush}"
                    Foreground="White"
                    CornerRadius="6"
                    Padding="20,10"
                    HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="10">
                <icons:Icon Value="fa-solid fa-vial" />
                <TextBlock Text="Run Validation" FontWeight="SemiBold" VerticalAlignment="Center" />
              </StackPanel>
            </Button>

            <!-- Error Display -->
            <Border IsVisible="{Binding ValidationError, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                    Background="{DynamicResource DangerBackgroundBrush}"
                    BorderBrush="{DynamicResource DangerBrush}"
                    BorderThickness="1"
                    Padding="16"
                    CornerRadius="8">
              <StackPanel Orientation="Horizontal" Spacing="12">
                <icons:Icon Value="fa-solid fa-circle-exclamation" Foreground="{DynamicResource DangerBrush}" />
                <TextBlock Text="{Binding ValidationError}" 
                           Foreground="{DynamicResource DangerBrush}" 
                           VerticalAlignment="Center" 
                           FontWeight="Medium"
                           TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
