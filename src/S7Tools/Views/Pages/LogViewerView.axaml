<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Pages"
             xmlns:models="using:S7Tools.Core.Models"
             xmlns:conv="clr-namespace:S7Tools.Converters"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="600"
             x:Class="S7Tools.Views.Pages.LogViewerView"
             x:DataType="vm:LogViewerViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <Grid RowDefinitions="Auto,*" Background="{DynamicResource AppBackgroundBrush}">
      <!-- Toolbar -->
    <Border Grid.Row="0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,0,1">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,8" Spacing="8">
          <!-- Title -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,8,0" VerticalAlignment="Center">
            <icons:Icon Value="fa-solid fa-list-ul" Foreground="{DynamicResource TextForegroundSecondaryBrush}" Width="16" Height="16" />
            <TextBlock Text="LOG VIEWER" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" LetterSpacing="0.5" />
          </StackPanel>

          <!-- Search -->
          <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                   Watermark="Filter messages..."
                   Height="28"
                   Width="250"
                   VerticalAlignment="Center"
                   Classes="SearchBox">
            <TextBox.InnerLeftContent>
              <icons:Icon Value="fa-solid fa-search" Margin="8,0,0,0" Width="12" Opacity="0.5" />
            </TextBox.InnerLeftContent>
            <TextBox.InnerRightContent>
              <Button Command="{Binding ClearFiltersCommand}"
                      IsVisible="{Binding SearchText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
                      Background="Transparent" BorderThickness="0" Padding="6,0">
                <icons:Icon Value="fa-solid fa-times" Width="10" Opacity="0.5" />
              </Button>
            </TextBox.InnerRightContent>
          </TextBox>

          <Rectangle Width="1" Height="16" Fill="{DynamicResource ControlBorderBrush}" VerticalAlignment="Center" />

          <!-- Filters & Actions -->
          <ComboBox SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                    ItemsSource="{Binding AvailableLogLevels}"
                    Width="120"
                    Height="28"
                    VerticalAlignment="Center">
            <ComboBox.ItemTemplate>
              <DataTemplate>
                <Border HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Padding="6,2"
                        CornerRadius="4"
                        Background="{Binding Converter={x:Static conv:ObjectConverters.LogLevelToBrush}}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <icons:Icon Value="{Binding Converter={x:Static conv:ObjectConverters.LogLevelToIcon}}" Width="10" Height="10" Foreground="White" />
                    <TextBlock Text="{Binding}" FontSize="10" FontWeight="Bold" Foreground="White" />
                  </StackPanel>
                </Border>
              </DataTemplate>
            </ComboBox.ItemTemplate>
          </ComboBox>

          <ToggleButton IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                        Height="28"
                        Padding="8,0"
                        VerticalAlignment="Center"
                        ToolTip.Tip="Automatically scroll to newest logs">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:Icon Value="fa-solid fa-arrow-down" Width="12" />
              <TextBlock Text="Auto-Scroll" FontSize="12" />
            </StackPanel>
          </ToggleButton>

          <Rectangle Width="1" Height="16" Fill="{DynamicResource ControlBorderBrush}" VerticalAlignment="Center" />

          <Button Height="28" Padding="8,0" Background="Transparent" BorderThickness="0">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:Icon Value="fa-solid fa-download" Width="12" />
              <TextBlock Text="Export" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
            <Button.Flyout>
              <MenuFlyout Placement="Bottom">
                <MenuItem Header="As JSON" Command="{Binding ExportLogsCommand}" CommandParameter="json">
                  <MenuItem.Icon><icons:Icon Value="fa-solid fa-file-code" Width="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="As Text" Command="{Binding ExportLogsCommand}" CommandParameter="txt">
                  <MenuItem.Icon><icons:Icon Value="fa-solid fa-file-alt" Width="12" /></MenuItem.Icon>
                </MenuItem>
                <MenuItem Header="As CSV" Command="{Binding ExportLogsCommand}" CommandParameter="csv">
                  <MenuItem.Icon><icons:Icon Value="fa-solid fa-file-csv" Width="12" /></MenuItem.Icon>
                </MenuItem>
              </MenuFlyout>
            </Button.Flyout>
          </Button>

          <Button Command="{Binding ClearLogsCommand}"
                  Height="28"
                  Background="#D13438"
                  Foreground="White"
                  Padding="12,0"
                  ToolTip.Tip="Clear all log entries">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <icons:Icon Value="fa-solid fa-trash-can" Width="12" Height="12" />
              <TextBlock Text="Clear" FontSize="12" VerticalAlignment="Center" FontWeight="SemiBold" />
            </StackPanel>
          </Button>
        </StackPanel>
      </ScrollViewer>
    </Border>
  
    <!-- Content Area -->
    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
      <Grid RowDefinitions="Auto,*">
          <!-- Headers -->
        <Border Grid.Row="0" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
          <Grid ColumnDefinitions="180,100,150,*" Margin="12,4">
            <TextBlock Grid.Column="0" Text="TIMESTAMP" FontSize="11" FontWeight="Bold" Opacity="0.6" />
            <TextBlock Grid.Column="1" Text="LEVEL" FontSize="11" FontWeight="Bold" Opacity="0.6" />
            <TextBlock Grid.Column="2" Text="CATEGORY" FontSize="11" FontWeight="Bold" Opacity="0.6" />
            <TextBlock Grid.Column="3" Text="MESSAGE" FontSize="11" FontWeight="Bold" Opacity="0.6" />
          </Grid>
        </Border>
  
        <!-- Log List -->
        <ListBox Grid.Row="1"
                 Name="LogListBox"
                 ItemsSource="{Binding FilteredLogEntries}"
                 SelectedItem="{Binding SelectedLogEntry}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <VirtualizingStackPanel />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>
  
          <ListBox.Styles>
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0" />
              <Setter Property="Background" Value="Transparent" />
              <Style Selector="^:pointerover /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ControlHoverBackgroundBrush}" />
              </Style>
              <Style Selector="^:selected /template/ ContentPresenter">
                <Setter Property="Background" Value="{DynamicResource ControlSelectedBackgroundBrush}" />
              </Style>
            </Style>
          </ListBox.Styles>
  
          <ListBox.ItemTemplate>
            <DataTemplate DataType="models:LogModel">
              <Border BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="180,100,150,*" Margin="12,6">
                  <TextBlock Grid.Column="0"
                             Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"
                             FontSize="12"
                             FontFamily="JetBrains Mono, Cascadia Code, Consolas, monospace"
                             Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                             VerticalAlignment="Center" />
  
                  <Border Grid.Column="1"
                          HorizontalAlignment="Left"
                          VerticalAlignment="Center"
                          Padding="6,2"
                          CornerRadius="4"
                          Background="{Binding Level, Converter={x:Static conv:ObjectConverters.LogLevelToBrush}}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <icons:Icon Value="{Binding Level, Converter={x:Static conv:ObjectConverters.LogLevelToIcon}}" Width="10" Height="10" Foreground="White" />
                      <TextBlock Text="{Binding Level}" FontSize="10" FontWeight="Bold" Foreground="White" />
                    </StackPanel>
                  </Border>
  
                  <TextBlock Grid.Column="2"
                             Text="{Binding Category}"
                             FontSize="12"
                             Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                             VerticalAlignment="Center"
                             TextTrimming="CharacterEllipsis"
                             Margin="0,0,10,0" />
  
                  <TextBlock Grid.Column="3"
                             Text="{Binding FormattedMessage}"
                             FontSize="12"
                             Foreground="{DynamicResource TextForegroundBrush}"
                             VerticalAlignment="Center"
                             TextWrapping="NoWrap" />
                </Grid>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </Grid>
    </ScrollViewer>
  </Grid>
</UserControl>
