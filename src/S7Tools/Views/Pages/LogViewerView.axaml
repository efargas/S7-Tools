<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:S7Tools.ViewModels.Pages"
    xmlns:models="using:S7Tools.Core.Models"
    xmlns:converters="clr-namespace:S7Tools.Converters"
    xmlns:ui="using:FluentAvalonia.UI.Controls"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
    x:Class="S7Tools.Views.Pages.LogViewerView"
    x:DataType="vm:LogViewerViewModel"
    x:CompileBindings="True"
    Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:LogViewerViewModel />
    </Design.DataContext>

    <Grid RowDefinitions="Auto,Auto,*">

        <!-- ── TOOLBAR ── -->
        <Border Grid.Row="0"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,0,1"
            Padding="8,4">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0" Spacing="4">
                    
                    <!-- Search -->
                    <TextBox Text="{Binding SearchText, Mode=TwoWay}"
                             Watermark="Search logs..."
                             Width="200"
                             Margin="8,0,8,0"
                             VerticalAlignment="Center">
                        <TextBox.InnerRightContent>
                            <Button Background="Transparent" BorderThickness="0" Padding="4"
                                    Command="{Binding ClearFiltersCommand}"
                                    ToolTip.Tip="Clear search and filters">
                                <TextBlock Text="✕" FontSize="10" />
                            </Button>
                        </TextBox.InnerRightContent>
                    </TextBox>
                    
                    <!-- Filter Level -->
                    <TextBlock Text="Level:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <ComboBox SelectedItem="{Binding SelectedLogLevel, Mode=TwoWay}"
                              ItemsSource="{Binding AvailableLogLevels}"
                              Width="120"
                              Margin="0,0,8,0"
                              VerticalAlignment="Center"/>
                              
                    <Separator Width="1" Height="20" Background="{DynamicResource ControlBorderBrush}" Margin="8,0"/>
    
                    <!-- Auto-Scroll Toggle -->
                    <ToggleButton IsChecked="{Binding AutoScroll, Mode=TwoWay}"
                                  Content="Auto-Scroll"
                                  Margin="8,0"
                                  VerticalAlignment="Center"/>
    
                    <Separator Width="1" Height="20" Background="{DynamicResource ControlBorderBrush}" Margin="8,0"/>
                    
                    <!-- Export -->
                    <TextBlock Text="Export:" VerticalAlignment="Center" Margin="8,0,4,0"/>
                    <Button Content="JSON" Command="{Binding ExportLogsCommand}" CommandParameter="json" 
                            Margin="0,0,4,0" Padding="8,2" MinWidth="60"
                            HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="TXT" Command="{Binding ExportLogsCommand}" CommandParameter="txt" 
                            Margin="0,0,4,0" Padding="8,2" MinWidth="55"
                            HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                    <Button Content="CSV" Command="{Binding ExportLogsCommand}" CommandParameter="csv" 
                            Margin="0,0,8,0" Padding="8,2" MinWidth="55"
                            HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
    
                    <Separator Width="1" Height="20" Background="{DynamicResource ControlBorderBrush}" Margin="8,0"/>
    
                    <!-- Clear -->
                    <Button Content="Clear Logs" Command="{Binding ClearLogsCommand}" 
                            Margin="4,0,0,0" Padding="12,2" MinWidth="100"
                            HorizontalContentAlignment="Center" VerticalAlignment="Center"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ── HEADER (fixed, never scrolls) ── -->
        <Border Grid.Row="1"
            Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource ControlBorderBrush}"
            BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="165,100,150,*" Margin="8,1">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="Timestamp" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Classes="compact" Background="Transparent" BorderThickness="0"
                        Padding="4,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                        Command="{Binding SortCommand}" CommandParameter="Timestamp">
                        <ui:SymbolIcon Symbol="Sort" FontSize="10" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="Level" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Classes="compact" Background="Transparent" BorderThickness="0"
                        Padding="4,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                        Command="{Binding SortCommand}" CommandParameter="Level">
                        <ui:SymbolIcon Symbol="Sort" FontSize="10" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="Category" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Classes="compact" Background="Transparent" BorderThickness="0"
                        Padding="4,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                        Command="{Binding SortCommand}" CommandParameter="Category">
                        <ui:SymbolIcon Symbol="Sort" FontSize="10" />
                    </Button>
                </StackPanel>
                <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="Message" FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" VerticalAlignment="Center" />
                    <Button Classes="compact" Background="Transparent" BorderThickness="0"
                        Padding="4,0" VerticalAlignment="Center"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                        Command="{Binding SortCommand}" CommandParameter="Message">
                        <ui:SymbolIcon Symbol="Sort" FontSize="10" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ── VIRTUALIZED LOG LIST ── -->
        <ListBox Grid.Row="2"
                 Name="LogListBox"
                 ItemsSource="{Binding FilteredLogEntries}"
                 SelectedItem="{Binding SelectedLogEntry, Mode=TwoWay}"
                 Background="Transparent"
                 BorderThickness="0"
                 Padding="0">
            <ListBox.ItemsPanel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel />
                </ItemsPanelTemplate>
            </ListBox.ItemsPanel>
            
            <ListBox.Styles>
                <Style Selector="ListBoxItem">
                    <Setter Property="Padding" Value="0"/>
                    <Setter Property="Margin" Value="0"/>
                    <Setter Property="MinHeight" Value="0"/>
                </Style>
            </ListBox.Styles>

            <ListBox.ItemTemplate>
                <DataTemplate DataType="models:LogModel">
                    <Border BorderBrush="{DynamicResource ControlBorderBrush}"
                        BorderThickness="0,0,0,1"
                        Padding="0,2">

                        <Border.ContextMenu>
                            <ContextMenu>
                                <MenuItem Header="Copy Full Entry"
                                    Command="{Binding #LogListBox.((vm:LogViewerViewModel)DataContext).CopySelectedEntryCommand}"
                                    CommandParameter="{Binding}" />
                                <MenuItem Header="Copy Message"
                                    Command="{Binding #LogListBox.((vm:LogViewerViewModel)DataContext).CopySelectedMessageCommand}"
                                    CommandParameter="{Binding}" />
                            </ContextMenu>
                        </Border.ContextMenu>

                        <Grid ColumnDefinitions="165,100,150,*">
                            <TextBlock Grid.Column="0"
                                Text="{Binding Timestamp, StringFormat='yyyy-MM-dd HH:mm:ss.fff'}"
                                FontSize="{Binding $parent[UserControl].DataContext.FontSize}"
                                Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                                VerticalAlignment="Center" Margin="8,0" />

                            <Border Grid.Column="1"
                                CornerRadius="2" Padding="3,1" Margin="4,1"
                                HorizontalAlignment="Left" VerticalAlignment="Center"
                                Background="{Binding Level, Converter={x:Static converters:ObjectConverters.LogLevelToBrush}}">
                                <TextBlock Text="{Binding Level}"
                                    FontSize="9" FontWeight="SemiBold" Foreground="White" />
                            </Border>

                            <TextBlock Grid.Column="2"
                                Text="{Binding Category}"
                                FontSize="{Binding $parent[UserControl].DataContext.FontSize}"
                                Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                                VerticalAlignment="Center" Margin="8,0"
                                TextTrimming="CharacterEllipsis" />

                            <TextBlock Grid.Column="3"
                                Text="{Binding FormattedMessage}"
                                FontSize="{Binding $parent[UserControl].DataContext.FontSize}"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                VerticalAlignment="Center" Margin="8,0"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
