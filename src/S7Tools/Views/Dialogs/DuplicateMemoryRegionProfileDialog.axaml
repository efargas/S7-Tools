<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:S7Tools.ViewModels.Dialogs"
        mc:Ignorable="d" d:DesignWidth="500" d:DesignHeight="400"
        x:Class="S7Tools.Views.Dialogs.DuplicateMemoryRegionProfileDialog"
        x:DataType="vm:DuplicateMemoryRegionProfileDialogViewModel"
        Title="Duplicate Memory Region Profile"
        Width="500" Height="400"
        MinWidth="450" MinHeight="350"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Icons/memory-profile.png"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">

  <Design.DataContext>
    <vm:DuplicateMemoryRegionProfileDialogViewModel />
  </Design.DataContext>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header Section -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAccentBrush}"
            CornerRadius="4"
            Padding="12"
            Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Path Grid.Column="0"
              Width="24" Height="24"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
              Data="M11,17H4A2,2 0 0,1 2,15V3A2,2 0 0,1 4,1H16V3H4V15H11V13L15,16L11,19V17M19,21V7H8V13H6V7A2,2 0 0,1 8,5H19A2,2 0 0,1 21,7V21A2,2 0 0,1 19,23H8A2,2 0 0,1 6,21V19H8V21H19Z" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Duplicate Memory Region Profile"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          <TextBlock Text="Create a copy of an existing profile with a new name"
                     FontSize="12" Opacity="0.8"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <!-- Source Profile Information -->
        <Expander Header="Source Profile" IsExpanded="True">
          <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                  CornerRadius="4"
                  Padding="12"
                  Margin="0,8,0,0">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <!-- Name -->
              <TextBlock Grid.Row="0" Grid.Column="0"
                         Text="Name:" FontWeight="Medium"
                         Margin="0,0,12,4"
                         VerticalAlignment="Top" />
              <TextBlock Grid.Row="0" Grid.Column="1"
                         Text="{Binding SourceProfileName}"
                         FontWeight="SemiBold"
                         TextWrapping="Wrap"
                         Margin="0,0,0,4" />

              <!-- Description -->
              <TextBlock Grid.Row="1" Grid.Column="0"
                         Text="Description:" FontWeight="Medium"
                         Margin="0,0,12,8"
                         VerticalAlignment="Top" />
              <TextBlock Grid.Row="1" Grid.Column="1"
                         Text="{Binding SourceDescription}"
                         TextWrapping="Wrap"
                         Opacity="0.8"
                         Margin="0,0,0,8" />

              <!-- Statistics -->
              <TextBlock Grid.Row="2" Grid.Column="0"
                         Text="Segments:" FontWeight="Medium"
                         Margin="0,0,12,4"
                         VerticalAlignment="Top" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="16" Margin="0,0,0,4">
                <TextBlock>
                  <Run Text="{Binding SourceSegmentCount}" FontWeight="SemiBold" />
                  <Run Text="total" />
                </TextBlock>
                <TextBlock>
                  <Run Text="{Binding SourceSelectedSegmentCount}" FontWeight="SemiBold"
                       Foreground="{DynamicResource SystemControlHighlightAccentBrush}" />
                  <Run Text="selected" />
                </TextBlock>
              </StackPanel>

            </Grid>
          </Border>
        </Expander>

        <!-- Duplicate Configuration -->
        <Expander Header="Duplicate Configuration" IsExpanded="True">
          <StackPanel Spacing="12" Margin="0,8,0,0">

            <!-- New Profile Name -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="New Profile Name *"
                         FontWeight="Medium" Margin="0,0,0,4" />

              <TextBox Grid.Row="1"
                       Text="{Binding NewProfileName}"
                       Watermark="Enter a unique name for the duplicate profile"
                       Classes.error="{Binding !IsValid}" />

              <!-- Suggested Name Button -->
              <Button Grid.Row="2"
                      Command="{Binding UseSuggestedNameCommand}"
                      HorizontalAlignment="Left"
                      Margin="0,4,0,0"
                      Classes="tertiary">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Width="12" Height="12"
                        Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Data="M9.5,3A6.5,6.5 0 0,1 16,9.5C16,11.11 15.41,12.59 14.44,13.73L14.71,14H15.5L20.5,19L19,20.5L14,15.5V14.71L13.73,14.44C12.59,15.41 11.11,16 9.5,16A6.5,6.5 0 0,1 3,9.5A6.5,6.5 0 0,1 9.5,3M9.5,5C7,5 5,7 5,9.5C5,12 7,14 9.5,14C12,14 14,12 14,9.5C14,7 12,5 9.5,5Z" />
                  <TextBlock>
                    <Run Text="Use suggested:" />
                    <Run Text="{Binding SuggestedName}" FontWeight="Medium" />
                  </TextBlock>
                </StackPanel>
              </Button>

            </Grid>

            <!-- New Description -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Description"
                         FontWeight="Medium" Margin="0,0,0,4" />

              <TextBox Grid.Row="1"
                       Text="{Binding NewDescription}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="60"
                       Watermark="Optional description for the duplicate profile" />

              <!-- Reset Description Button -->
              <Button Grid.Row="2"
                      Command="{Binding ResetDescriptionCommand}"
                      HorizontalAlignment="Left"
                      Margin="0,4,0,0"
                      Classes="tertiary">
                <StackPanel Orientation="Horizontal" Spacing="4">
                  <Path Width="12" Height="12"
                        Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                        Data="M12,4C14,4 16,5 17,7H22V9H19V11H17V9H15C14,11 12,12 10,12C8,12 6,11 5,9H2V7H7C8,5 10,4 12,4M12,6A2,2 0 0,0 10,8A2,2 0 0,0 12,10A2,2 0 0,0 14,8A2,2 0 0,0 12,6Z" />
                  <TextBlock Text="Reset to original description" />
                </StackPanel>
              </Button>

            </Grid>

          </StackPanel>
        </Expander>

        <!-- Duplication Options -->
        <Expander Header="Duplication Options" IsExpanded="True">
          <StackPanel Spacing="12" Margin="0,8,0,0">

            <!-- Copy Segment Selections -->
            <CheckBox IsChecked="{Binding CopySegmentSelections}">
              <StackPanel>
                <TextBlock Text="Copy segment selections" FontWeight="Medium" />
                <TextBlock Text="Include which segments are selected for memory dump operations"
                           FontSize="11" Opacity="0.7"
                           TextWrapping="Wrap" />
              </StackPanel>
            </CheckBox>

            <!-- Info Panel -->
            <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    CornerRadius="4"
                    Padding="12">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Path Width="16" Height="16"
                      Fill="{DynamicResource SystemControlHighlightAccentBrush}"
                      Data="M13,9H11V7H13M13,17H11V11H13M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2Z" />
                <StackPanel>
                  <TextBlock Text="Duplication Information" FontWeight="Medium" />
                  <TextBlock FontSize="11" Opacity="0.8" TextWrapping="Wrap">
                    <Run Text="The duplicate will include all memory segments from the source profile." />
                    <LineBreak />
                    <Run Text="Segment addresses, sizes, and types will be copied exactly." />
                    <LineBreak />
                    <Run Text="You can modify the duplicate after creation." />
                  </TextBlock>
                </StackPanel>
              </StackPanel>
            </Border>

          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <!-- Validation Message -->
    <Border Grid.Row="2"
            IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{DynamicResource SystemControlErrorTextForegroundBrush}"
            CornerRadius="4"
            Padding="12"
            Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Width="16" Height="16"
              Fill="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              Data="M13,13H11V7H13M12,17.3A1.3,1.3 0 0,1 10.7,16A1.3,1.3 0 0,1 12,14.7A1.3,1.3 0 0,1 13.3,16A1.3,1.3 0 0,1 12,17.3M15.73,3H8.27L3,8.27V15.73L8.27,21H15.73L21,15.73V8.27L15.73,3Z" />
        <TextBlock Text="{Binding ValidationMessage}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Action Buttons -->
    <Border Grid.Row="3"
            Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
            CornerRadius="4"
            Padding="12"
            Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">

        <Button Command="{Binding CancelCommand}"
                Content="Cancel"
                IsCancel="True"
                Padding="16,8" />

        <Button Command="{Binding DuplicateCommand}"
                Content="Duplicate Profile"
                IsDefault="True"
                IsEnabled="{Binding IsValid}"
                Classes="accent"
                Padding="16,8" />

      </StackPanel>
    </Border>

  </Grid>
</Window>
