<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:S7Tools.ViewModels.Dialogs"
        xmlns:models="clr-namespace:S7Tools.Core.Models;assembly=S7Tools.Core"
        mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="500"
        x:Class="S7Tools.Views.Dialogs.CreateMemoryRegionProfileDialog"
        x:DataType="vm:CreateMemoryRegionProfileDialogViewModel"
        Title="Create Memory Region Profile"
        Width="600" Height="500"
        MinWidth="500" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        Icon="/Assets/Icons/memory-profile.png"
        Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}">

  <Design.DataContext>
    <vm:CreateMemoryRegionProfileDialogViewModel />
  </Design.DataContext>

  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Header Section -->
    <Border Grid.Row="0"
            Background="{DynamicResource SystemControlBackgroundAccentBrush}"
            CornerRadius="4"
            Padding="12"
            Margin="0,0,0,16">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Path Grid.Column="0"
              Width="24" Height="24"
              Margin="0,0,12,0"
              VerticalAlignment="Center"
              Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
              Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z" />

        <StackPanel Grid.Column="1" VerticalAlignment="Center">
          <TextBlock Text="Create New Memory Region Profile"
                     FontSize="16" FontWeight="SemiBold"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
          <TextBlock Text="Configure memory segments for PLC firmware dumping operations"
                     FontSize="12" Opacity="0.8"
                     Foreground="{DynamicResource SystemControlForegroundBaseHighBrush}" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Main Content -->
    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="16">

        <!-- Basic Information Section -->
        <Expander Header="Basic Information" IsExpanded="True">
          <StackPanel Spacing="12" Margin="0,8,0,0">

            <!-- Profile Name -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Profile Name *"
                         FontWeight="Medium" Margin="0,0,0,4" />
              <TextBox Grid.Row="1"
                       Text="{Binding ProfileName}"
                       Watermark="Enter a unique name for this profile"
                       Classes.error="{Binding !IsValid}" />
            </Grid>

            <!-- Description -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Row="0" Text="Description"
                         FontWeight="Medium" Margin="0,0,0,4" />
              <TextBox Grid.Row="1"
                       Text="{Binding Description}"
                       AcceptsReturn="True"
                       TextWrapping="Wrap"
                       MinHeight="60"
                       Watermark="Optional description for this memory region profile" />
            </Grid>

          </StackPanel>
        </Expander>

        <!-- Configuration Method Section -->
        <Expander Header="Configuration Method" IsExpanded="True">
          <StackPanel Spacing="12" Margin="0,8,0,0">

            <!-- Template/Custom Toggle -->
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <RadioButton Grid.Row="0"
                           IsChecked="{Binding UseTemplate}"
                           Content="Use predefined template"
                           FontWeight="Medium" />

              <RadioButton Grid.Row="1"
                           IsChecked="{Binding UseCustomSegments}"
                           Content="Define custom segments"
                           FontWeight="Medium"
                           Margin="0,8,0,0" />

              <!-- Template Selection -->
              <Border Grid.Row="2"
                      IsVisible="{Binding UseTemplate}"
                      Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                      CornerRadius="4"
                      Padding="12"
                      Margin="16,8,0,0">
                <StackPanel Spacing="8">

                  <TextBlock Text="Select Template:" FontWeight="Medium" />

                  <ComboBox ItemsSource="{Binding AvailableTemplates}"
                            SelectedItem="{Binding SelectedTemplate}"
                            HorizontalAlignment="Stretch">
                    <ComboBox.ItemTemplate>
                      <DataTemplate x:DataType="vm:MemoryRegionTemplate">
                        <StackPanel>
                          <TextBlock Text="{Binding Name}" FontWeight="Medium" />
                          <TextBlock Text="{Binding Description}"
                                     FontSize="11" Opacity="0.7"
                                     TextWrapping="Wrap" />
                        </StackPanel>
                      </DataTemplate>
                    </ComboBox.ItemTemplate>
                  </ComboBox>

                  <!-- Template Preview -->
                  <Border IsVisible="{Binding SelectedTemplate, Converter={x:Static ObjectConverters.IsNotNull}}"
                          Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                          CornerRadius="4"
                          Padding="8"
                          Margin="0,8,0,0">
                    <StackPanel>
                      <TextBlock Text="Template Segments:"
                                 FontWeight="Medium"
                                 Margin="0,0,0,4" />
                      <ItemsControl ItemsSource="{Binding SelectedTemplate.Segments}">
                        <ItemsControl.ItemTemplate>
                          <DataTemplate x:DataType="models:MemorySegment">
                            <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                                    CornerRadius="2"
                                    Padding="6"
                                    Margin="0,2">
                              <Grid>
                                <Grid.ColumnDefinitions>
                                  <ColumnDefinition Width="*" />
                                  <ColumnDefinition Width="Auto" />
                                  <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                           Text="{Binding Name}"
                                           FontWeight="Medium"
                                           VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1"
                                           Text="{Binding AddressRange}"
                                           FontFamily="Consolas"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Margin="8,0" />

                                <TextBlock Grid.Column="2"
                                           Text="{Binding SizeFormatted}"
                                           FontSize="11"
                                           VerticalAlignment="Center"
                                           Opacity="0.7" />
                              </Grid>
                            </Border>
                          </DataTemplate>
                        </ItemsControl.ItemTemplate>
                      </ItemsControl>
                    </StackPanel>
                  </Border>

                </StackPanel>
              </Border>

            </Grid>
          </StackPanel>
        </Expander>

        <!-- Custom Segments Section -->
        <Expander Header="Custom Segments"
                  IsExpanded="{Binding UseCustomSegments}"
                  IsVisible="{Binding UseCustomSegments}">
          <StackPanel Spacing="12" Margin="0,8,0,0">

            <!-- Segment Management Toolbar -->
            <Border Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
                    CornerRadius="4"
                    Padding="8">
              <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Command="{Binding AddSegmentCommand}"
                        Classes="accent">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="14" Height="14"
                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="M19,13H13V19H11V13H5V11H11V5H13V11H19V13Z" />
                    <TextBlock Text="Add Segment" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding RemoveSegmentCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="14" Height="14"
                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="M19,13H5V11H19V13Z" />
                    <TextBlock Text="Remove" />
                  </StackPanel>
                </Button>

                <Button Command="{Binding EditSegmentCommand}">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <Path Width="14" Height="14"
                          Fill="{DynamicResource SystemControlForegroundBaseHighBrush}"
                          Data="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
                    <TextBlock Text="Edit" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Border>

            <!-- Custom Segments List -->
            <Border Background="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                    CornerRadius="4"
                    Padding="8"
                    MinHeight="150">

              <Grid>
                <!-- Empty State -->
                <StackPanel IsVisible="{Binding CustomSegments.Count, Converter={x:Static ObjectConverters.Equal}, ConverterParameter=0}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Spacing="8">
                  <Path Width="48" Height="48"
                        Fill="{DynamicResource SystemControlForegroundBaseMediumBrush}"
                        Data="M12,2A10,10 0 0,1 22,12A10,10 0 0,1 12,22A10,10 0 0,1 2,12A10,10 0 0,1 12,2M12,4A8,8 0 0,0 4,12A8,8 0 0,0 12,20A8,8 0 0,0 20,12A8,8 0 0,0 12,4M11,16.5L6.5,12L7.91,10.59L11,13.67L16.59,8.09L18,9.5L11,16.5Z"
                        HorizontalAlignment="Center" />
                  <TextBlock Text="No custom segments defined"
                             FontSize="14"
                             HorizontalAlignment="Center"
                             Foreground="{DynamicResource SystemControlForegroundBaseMediumBrush}" />
                  <TextBlock Text="Click 'Add Segment' to create your first custom segment"
                             FontSize="12"
                             HorizontalAlignment="Center"
                             Opacity="0.7" />
                </StackPanel>

                <!-- Segments List -->
                <ListBox ItemsSource="{Binding CustomSegments}"
                         SelectedItem="{Binding SelectedSegment}"
                         IsVisible="{Binding CustomSegments.Count, Converter={x:Static ObjectConverters.NotEqual}, ConverterParameter=0}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="models:MemorySegment">
                      <Border Background="{DynamicResource SystemControlBackgroundAltMediumBrush}"
                              CornerRadius="4"
                              Padding="8"
                              Margin="2">
                        <Grid>
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                          </Grid.ColumnDefinitions>

                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding Name}"
                                       FontWeight="Medium" />
                            <TextBlock Text="{Binding Description}"
                                       FontSize="11"
                                       Opacity="0.7" />
                          </StackPanel>

                          <TextBlock Grid.Column="1"
                                     Text="{Binding AddressRange}"
                                     FontFamily="Consolas"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="8,0" />

                          <TextBlock Grid.Column="2"
                                     Text="{Binding SizeFormatted}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Margin="8,0" />

                          <TextBlock Grid.Column="3"
                                     Text="{Binding Type}"
                                     FontSize="11"
                                     VerticalAlignment="Center"
                                     Opacity="0.7" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

              </Grid>
            </Border>

          </StackPanel>
        </Expander>

      </StackPanel>
    </ScrollViewer>

    <!-- Validation Message -->
    <Border Grid.Row="2"
            IsVisible="{Binding ValidationMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"
            Background="{DynamicResource SystemControlErrorTextForegroundBrush}"
            CornerRadius="4"
            Padding="12"
            Margin="0,8,0,0">
      <StackPanel Orientation="Horizontal" Spacing="8">
        <Path Width="16" Height="16"
              Fill="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
              Data="M13,13H11V7H13M12,17.3A1.3,1.3 0 0,1 10.7,16A1.3,1.3 0 0,1 12,14.7A1.3,1.3 0 0,1 13.3,16A1.3,1.3 0 0,1 12,17.3M15.73,3H8.27L3,8.27V15.73L8.27,21H15.73L21,15.73V8.27L15.73,3Z" />
        <TextBlock Text="{Binding ValidationMessage}"
                   FontWeight="Medium"
                   Foreground="{DynamicResource SystemControlBackgroundChromeMediumBrush}"
                   TextWrapping="Wrap" />
      </StackPanel>
    </Border>

    <!-- Action Buttons -->
    <Border Grid.Row="3"
            Background="{DynamicResource SystemControlBackgroundAltMediumLowBrush}"
            CornerRadius="4"
            Padding="12"
            Margin="0,16,0,0">
      <StackPanel Orientation="Horizontal"
                  HorizontalAlignment="Right"
                  Spacing="8">

        <Button Command="{Binding CancelCommand}"
                Content="Cancel"
                IsCancel="True"
                Padding="16,8" />

        <Button Command="{Binding CreateCommand}"
                Content="Create Profile"
                IsDefault="True"
                IsEnabled="{Binding IsValid}"
                Classes="accent"
                Padding="16,8" />

      </StackPanel>
    </Border>

  </Grid>
</Window>
