<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="240" d:DesignHeight="650"
             x:Class="S7Tools.Views.SettingsCategoriesView"
             x:DataType="vm:SettingsViewModel"
             Background="#252526">

  <UserControl.Styles>
    <!-- Expander styling to match Jobs details view -->
    <Style Selector="Expander">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Transitions" Value="" />
    </Style>

    <!-- Border styling for sections -->
    <Style Selector="Border.CategorySection">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="#464647" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Margin" Value="0" />
    </Style>

    <!-- Header text styling -->
    <Style Selector="TextBlock.CategoryHeader">
      <Setter Property="FontWeight" Value="Normal" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Icon styling -->
    <Style Selector="icons|Icon.CategoryIcon">
      <Setter Property="Width" Value="14" />
      <Setter Property="Height" Value="14" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="Margin" Value="4,0" />
    </Style>

    <!-- Bullet icon styling for list items -->
    <Style Selector="icons|Icon.BulletIcon">
      <Setter Property="Width" Value="12" />
      <Setter Property="Height" Value="12" />
      <Setter Property="Foreground" Value="#CCCCCC" />
      <Setter Property="Value" Value="fa-solid fa-circle" />
    </Style>

    <!-- Arrow icon states -->
    <Style Selector="Expander:not(:expanded) icons|Icon.ExpanderArrow">
      <Setter Property="Value" Value="fa-solid fa-chevron-right" />
    </Style>

    <Style Selector="Expander:expanded icons|Icon.ExpanderArrow">
      <Setter Property="Value" Value="fa-solid fa-chevron-down" />
    </Style>
  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="0" Margin="0">
      <!-- Settings Section -->
      <Border Classes="CategorySection">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="32" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="CategoryIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="CategoryIcon" Value="fa-solid fa-cog" />
              <TextBlock Grid.Column="2" Classes="CategoryHeader" Text="SETTINGS" />
            </Grid>
          </Expander.Header>
          <ListBox ItemsSource="{Binding Categories}"
                   SelectedItem="{Binding SelectedCategory, Mode=TwoWay}"
                   Background="Transparent"
                   BorderThickness="0"
                   Margin="8,0,8,8"
                   SelectionMode="Single">
            <ListBox.Styles>
              <Style Selector="ListBoxItem">
                <Setter Property="Padding" Value="8,6"/>
                <Setter Property="Margin" Value="0,2"/>
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="CornerRadius" Value="4"/>
              </Style>
              <Style Selector="ListBoxItem:selected">
                <Setter Property="Background" Value="#37373D"/>
              </Style>
              <Style Selector="ListBoxItem:pointerover">
                <Setter Property="Background" Value="#2A2D2E"/>
              </Style>
            </ListBox.Styles>
            <ListBox.ItemTemplate>
              <DataTemplate DataType="sys:String">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <icons:Icon Classes="BulletIcon" />
                  <TextBlock Text="{Binding}" Foreground="#CCCCCC" FontSize="13"/>
                </StackPanel>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
