<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Tasks"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Tasks.TaskManagerView"
             x:DataType="vm:TaskManagerViewModel">

  <Grid RowDefinitions="Auto,Auto,*,Auto">
    <!-- Header Section with Statistics -->
    <Border Grid.Row="0" Background="{DynamicResource SystemRegionBrush}"
            BorderBrush="{DynamicResource SystemBaseLowBrush}" BorderThickness="0,0,0,1" Padding="16,12">
      <Grid ColumnDefinitions="*,Auto,Auto,Auto">
        <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12">
          <TextBlock Text="Task Manager" FontWeight="SemiBold" FontSize="18" VerticalAlignment="Center" />
          <Border Background="{DynamicResource SystemAccentBrush}" CornerRadius="12" Padding="8,4">
            <TextBlock Text="{Binding RunningTasksCount, StringFormat='Active: {0}'}"
                       Foreground="{DynamicResource SystemAltHighBrush}" FontSize="12" FontWeight="Medium" />
          </Border>
          <Border Background="{DynamicResource SystemBaseLowBrush}" CornerRadius="12" Padding="8,4">
            <TextBlock Text="{Binding TotalTasksCount, StringFormat='Total: {0}'}"
                       Foreground="{DynamicResource SystemBaseHighBrush}" FontSize="12" />
          </Border>
          <Border Background="#D32F2F" CornerRadius="12" Padding="8,4"
                  IsVisible="{Binding FailedTasksCount, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="{Binding FailedTasksCount, StringFormat='Failed: {0}'}"
                       Foreground="White" FontSize="12" />
          </Border>
        </StackPanel>

        <Button Grid.Column="1" Content="Create Task" Command="{Binding CreateTaskCommand}"
                Margin="0,0,16,0" ToolTip.Tip="Create a new task from a job profile" />

        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,16,0">
          <TextBlock Text="Auto-refresh:" VerticalAlignment="Center" FontSize="12" />
          <ToggleButton IsChecked="{Binding IsAutoRefreshEnabled}" ToolTip.Tip="Toggle automatic task list refresh" />
        </StackPanel>

        <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
          <Button Content="Refresh" Command="{Binding RefreshTasksCommand}"
                  ToolTip.Tip="Manually refresh task list" />
          <Button Content="Clear History" Command="{Binding ClearFinishedTasksCommand}"
                  ToolTip.Tip="Clear completed and failed tasks" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Quick Stats Section -->
    <Border Grid.Row="1" Background="#252526" Padding="16,12" Margin="16,16,16,0">
      <Grid ColumnDefinitions="*,*,*,*">
        <StackPanel Grid.Column="0" Spacing="4">
          <TextBlock Text="Created" FontSize="12" Foreground="{DynamicResource SystemBaseMediumBrush}" />
          <TextBlock Text="{Binding CreatedTasks.Count}" FontSize="24" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="1" Spacing="4">
          <TextBlock Text="Queued" FontSize="12" Foreground="{DynamicResource SystemBaseMediumBrush}" />
          <TextBlock Text="{Binding QueuedTasks.Count}" FontSize="24" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="2" Spacing="4">
          <TextBlock Text="Scheduled" FontSize="12" Foreground="{DynamicResource SystemBaseMediumBrush}" />
          <TextBlock Text="{Binding ScheduledTasks.Count}" FontSize="24" FontWeight="SemiBold" />
        </StackPanel>
        <StackPanel Grid.Column="3" Spacing="4">
          <TextBlock Text="Avg. Time" FontSize="12" Foreground="{DynamicResource SystemBaseMediumBrush}" />
          <TextBlock Text="{Binding AverageExecutionTime, StringFormat='{}{0:mm\\:ss}'}"
                     FontSize="24" FontWeight="SemiBold" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Body: Active tasks list -->
    <DataGrid Grid.Row="2" ItemsSource="{Binding ActiveTasks}"
              IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeColumns="True"
              GridLinesVisibility="Horizontal" HeadersVisibility="Column" Margin="16,0,16,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="240" />
        <DataGridTextColumn Header="Name" Binding="{Binding JobName}" Width="200" />
        <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="150" />
        <DataGridTextColumn Header="Progress" Binding="{Binding ProgressPercentage, StringFormat='{}{0:F1}%'}" Width="100" />
        <DataGridTextColumn Header="Started" Binding="{Binding StartedAt, StringFormat='HH:mm:ss'}" Width="80" />
        <DataGridTextColumn Header="Elapsed" Binding="{Binding ExecutionTime}" Width="80" />
        <DataGridTemplateColumn Header="Actions" Width="120">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Stop" FontSize="10" Padding="6,2"
                        Command="{Binding $parent[UserControl].DataContext.StopTaskCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Stop this task" />
                <Button Content="Details" FontSize="10" Padding="6,2"
                        Command="{Binding $parent[UserControl].DataContext.CreateTaskCommand}"
                        CommandParameter="{Binding}"
                        ToolTip.Tip="Show task details" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Status Bar -->
    <Border Grid.Row="3" Background="{DynamicResource SystemRegionBrush}"
            BorderBrush="{DynamicResource SystemBaseLowBrush}" BorderThickness="0,1,0,0" Padding="16,8">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="{Binding StatusMessage}"
                   Foreground="{DynamicResource SystemBaseMediumBrush}" FontSize="12" />
        <TextBlock Grid.Column="1" Text="{Binding LastUpdated, StringFormat='Last updated: {0:HH:mm:ss}'}"
                   Foreground="{DynamicResource SystemBaseMediumBrush}" FontSize="12" />
      </Grid>
    </Border>
  </Grid>

</UserControl>
