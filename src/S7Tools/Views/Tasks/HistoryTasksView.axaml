<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:S7Tools.ViewModels.Tasks"
  xmlns:views="using:S7Tools.Views.Tasks"
  mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
  x:Class="S7Tools.Views.Tasks.HistoryTasksView"
  x:DataType="vm:HistoryTasksViewModel">

  <Grid RowDefinitions="Auto,*,Auto,*">
    <!-- Header -->
    <Border Grid.Row="0" Background="{DynamicResource SystemRegionBrush}"
      CornerRadius="4,4,0,0" Padding="12,8">
      <Grid ColumnDefinitions="*,Auto,Auto">
        <TextBlock Grid.Column="0" Text="Recently Completed Tasks" FontWeight="Medium"
          VerticalAlignment="Center" />
        <TextBlock Grid.Column="1"
          Text="{Binding Manager.FinishedTasks.Count, StringFormat='{}{0} tasks'}"
          FontSize="12" Foreground="{DynamicResource SystemBaseMediumBrush}"
          VerticalAlignment="Center" Margin="0,0,12,0" />
        <Button Grid.Column="2" Content="Clear History"
          Command="{Binding Manager.ClearFinishedTasksCommand}"
          FontSize="11" Padding="8,4" ToolTip.Tip="Clear all finished tasks" />
      </Grid>
    </Border>

    <!-- Task List DataGrid -->
    <DataGrid Grid.Row="1" ItemsSource="{Binding Manager.FinishedTasks}"
      SelectedItem="{Binding SelectedHistoryTask}"
      IsReadOnly="True" CanUserReorderColumns="False" CanUserResizeColumns="True"
      GridLinesVisibility="Horizontal" HeadersVisibility="Column">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Task ID" Binding="{Binding TaskId}" Width="240" />
        <DataGridTextColumn Header="Name" Binding="{Binding JobName}" Width="200" />
        <DataGridTextColumn Header="Job" Binding="{Binding JobName}" Width="150" />
        <DataGridTextColumn Header="Status" Binding="{Binding State}" Width="100" />
        <DataGridTextColumn Header="Completed"
          Binding="{Binding CompletedAt, StringFormat='MM/dd HH:mm'}" Width="120" />
        <DataGridTextColumn Header="Duration" Binding="{Binding ExecutionTime}" Width="80" />
        <DataGridTemplateColumn Header="Failure Details" Width="250">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Vertical" Spacing="2">
                <TextBlock Text="{Binding ErrorMessage, FallbackValue='N/A'}"
                  FontSize="11" TextWrapping="Wrap" MaxWidth="240"
                  IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                <TextBlock FontSize="10" Foreground="{DynamicResource SystemBaseMediumBrush}"
                  IsVisible="{Binding FailedStep, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                  <Run Text="Failed at: " />
                  <Run Text="{Binding FailedStep}" FontWeight="SemiBold" />
                </TextBlock>
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
        <DataGridTemplateColumn Header="Actions" Width="100">
          <DataGridTemplateColumn.CellTemplate>
            <DataTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4">
                <Button Content="Restart" FontSize="10" Padding="6,2"
                  Command="{Binding $parent[UserControl].DataContext.Manager.RestartTaskCommand}"
                  CommandParameter="{Binding}"
                  ToolTip.Tip="Restart this task" />
              </StackPanel>
            </DataTemplate>
          </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>
      </DataGrid.Columns>
    </DataGrid>

    <!-- Task Details Header -->
    <Border Grid.Row="2" Background="{DynamicResource SystemRegionBrush}"
      BorderBrush="{DynamicResource SystemBaseLowBrush}" BorderThickness="0,1,0,1" Padding="12,8"
      IsVisible="{Binding SelectedHistoryTask, Converter={x:Static ObjectConverters.IsNotNull}}">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0" Text="Task Details" FontWeight="Medium" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Button Content="Open Logs Folder" Command="{Binding OpenLogsFolderCommand}"
            FontSize="11" Padding="8,4" />
          <Button Content="Open Dumps Folder" Command="{Binding OpenDumpsFolderCommand}"
            FontSize="11" Padding="8,4" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- Task Details Panel -->
    <Border Grid.Row="3" Background="#1E1E1E" Padding="16"
      IsVisible="{Binding SelectedHistoryTask, Converter={x:Static ObjectConverters.IsNotNull}}">
      <ScrollViewer>
        <StackPanel Spacing="16">
          <!-- Task Summary Section -->
          <Border Background="#2D2D30" BorderBrush="#3F3F46" BorderThickness="1" CornerRadius="4"
            Padding="12">
            <StackPanel Spacing="8">
              <TextBlock Text="Task Summary" FontWeight="SemiBold" FontSize="14" />
              <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" ColumnDefinitions="140,*"
                Margin="0,8,0,0">
                <TextBlock Grid.Row="0" Grid.Column="0" Text="Task ID:" FontSize="12"
                  Foreground="{DynamicResource SystemBaseMediumBrush}" />
                <TextBlock Grid.Row="0" Grid.Column="1"
                  Text="{Binding SelectedHistoryTask.TaskId, FallbackValue='-'}" FontSize="12" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="Job Name:" FontSize="12"
                  Foreground="{DynamicResource SystemBaseMediumBrush}" Margin="0,4,0,0" />
                <TextBlock Grid.Row="1" Grid.Column="1"
                  Text="{Binding SelectedHistoryTask.JobName, FallbackValue='-'}" FontSize="12"
                  Margin="0,4,0,0" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Created:" FontSize="12"
                  Foreground="{DynamicResource SystemBaseMediumBrush}" Margin="0,4,0,0" />
                <TextBlock Grid.Row="2" Grid.Column="1"
                  Text="{Binding SelectedHistoryTask.CreatedAt, StringFormat='yyyy-MM-dd HH:mm:ss', FallbackValue='-'}"
                  FontSize="12" Margin="0,4,0,0" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="Started:" FontSize="12"
                  Foreground="{DynamicResource SystemBaseMediumBrush}" Margin="0,4,0,0" />
                <TextBlock Grid.Row="3" Grid.Column="1"
                  Text="{Binding SelectedHistoryTask.StartedAt, StringFormat='yyyy-MM-dd HH:mm:ss', FallbackValue='-'}"
                  FontSize="12" Margin="0,4,0,0" />

                <TextBlock Grid.Row="4" Grid.Column="0" Text="Completed:" FontSize="12"
                  Foreground="{DynamicResource SystemBaseMediumBrush}" Margin="0,4,0,0" />
                <TextBlock Grid.Row="4" Grid.Column="1"
                  Text="{Binding SelectedHistoryTask.CompletedAt, StringFormat='yyyy-MM-dd HH:mm:ss', FallbackValue='-'}"
                  FontSize="12" Margin="0,4,0,0" />

                <TextBlock Grid.Row="5" Grid.Column="0" Text="Total Duration:" FontSize="12"
                  Foreground="{DynamicResource SystemBaseMediumBrush}" Margin="0,4,0,0" />
                <TextBlock Grid.Row="5" Grid.Column="1"
                  Text="{Binding SelectedHistoryTask.ExecutionTime, StringFormat='{}{0:mm\\:ss}', FallbackValue='-'}"
                  FontSize="12" Margin="0,4,0,0" />
              </Grid>

              <!-- Output File Info (for successful tasks) -->
              <Border Background="#1E1E1E" CornerRadius="4" Padding="8" Margin="0,8,0,0"
                IsVisible="{Binding SelectedHistoryTask.OutputFilePath, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Output File:" FontSize="11" FontWeight="SemiBold"
                    Foreground="{DynamicResource SystemAccentBrush}" />
                  <TextBlock Text="{Binding SelectedHistoryTask.OutputFilePath}" FontSize="11"
                    TextWrapping="Wrap" />
                  <TextBlock FontSize="10" Foreground="{DynamicResource SystemBaseMediumBrush}"
                    IsVisible="{Binding SelectedHistoryTask.OutputFileSize, Converter={x:Static ObjectConverters.IsNotNull}}">
                    <Run Text="Size: " />
                    <Run Text="{Binding SelectedHistoryTask.OutputFileSize}" />
                    <Run Text=" bytes" />
                  </TextBlock>
                </StackPanel>
              </Border>

              <!-- Error Info (for failed tasks) -->
              <Border Background="#3D1E1E" BorderBrush="#8B0000" BorderThickness="1"
                CornerRadius="4" Padding="8" Margin="0,8,0,0"
                IsVisible="{Binding SelectedHistoryTask.ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Spacing="4">
                  <TextBlock Text="Error Information:" FontSize="11" FontWeight="SemiBold"
                    Foreground="#FF6B6B" />
                  <TextBlock Text="{Binding SelectedHistoryTask.ErrorMessage}" FontSize="11"
                    TextWrapping="Wrap" Foreground="#FFB3B3" />
                  <TextBlock FontSize="10" Foreground="#FF9999"
                    IsVisible="{Binding SelectedHistoryTask.FailedStep, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                    <Run Text="Failed at step: " />
                    <Run Text="{Binding SelectedHistoryTask.FailedStep}" FontWeight="SemiBold" />
                  </TextBlock>
                </StackPanel>
              </Border>
            </StackPanel>
          </Border>

          <!-- Task Details View (Logs and Controls) -->
          <views:TaskDetailsView DataContext="{Binding TaskDetailsViewModel}" />
        </StackPanel>
      </ScrollViewer>
    </Border>
  </Grid>

</UserControl>