<UserControl xmlns="https://github.com/avaloniaui"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
  xmlns:vm="using:S7Tools.ViewModels.Tasks"
  xmlns:jobs="using:S7Tools.Core.Models.Jobs"
  xmlns:models="using:S7Tools.Models"
  xmlns:icons="using:Projektanker.Icons.Avalonia"
  xmlns:converters="clr-namespace:S7Tools.Converters"
  mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="800"
  x:Class="S7Tools.Views.Tasks.TaskDetailsView"
  x:DataType="vm:TaskDetailsViewModel">

  <UserControl.Resources>
    <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    <converters:ByteSpeedConverter x:Key="ByteSpeedConverter" />
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,Auto,*">
    <!-- Header with Task Name -->
    <Border Grid.Row="0" Background="{DynamicResource SystemRegionBrush}"
      BorderBrush="{DynamicResource SystemBaseLowBrush}" BorderThickness="0,0,0,1" Padding="12,6">
      <Grid ColumnDefinitions="*,Auto">
        <TextBlock Grid.Column="0"
          Text="{Binding TaskExecution.JobName, FallbackValue='No Task Selected'}"
          FontWeight="SemiBold" FontSize="14" VerticalAlignment="Center" />
        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
          <Border Background="{DynamicResource SystemAccentBrush}" CornerRadius="12" Padding="8,4">
            <TextBlock Text="{Binding TaskExecution.State, FallbackValue='Unknown'}"
              Foreground="{DynamicResource SystemAltHighBrush}" FontSize="12" FontWeight="Medium" />
          </Border>
        </StackPanel>
      </Grid>
    </Border>

    <!-- Task Info Panel with Progress Bar -->
    <Border Grid.Row="1" Background="{DynamicResource PanelBackgroundBrush}" Padding="12,8" Margin="0,0,0,4">
      <StackPanel Spacing="6">
        <!-- Progress Bar and Operation -->
        <Grid ColumnDefinitions="Auto,*,Auto" VerticalAlignment="Center">
          <TextBlock Grid.Column="0" Text="Progress:" FontSize="11" FontWeight="SemiBold"
            VerticalAlignment="Center" Margin="0,0,8,0" />
          <ProgressBar Grid.Column="1" Minimum="0" Maximum="100"
            Value="{Binding TaskExecution.ProgressPercentage, FallbackValue=0}"
            Height="6" VerticalAlignment="Center" />
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" Margin="8,0,0,0"
            VerticalAlignment="Center">
            <TextBlock
              Text="{Binding TaskExecution.ProgressPercentage, StringFormat='{}{0:F1}%', FallbackValue='0%'}"
              FontSize="11" FontWeight="Bold" Foreground="{DynamicResource SystemAccentBrush}" />
            <TextBlock Text="|" Foreground="#444444" FontSize="11" />
            <TextBlock Text="{Binding TaskExecution.CurrentOperation, FallbackValue='Idle'}"
              FontSize="11" Foreground="{DynamicResource SystemBaseMediumBrush}"
              FontStyle="Italic" />
          </StackPanel>
        </Grid>

        <!-- Inline Metadata -->
        <StackPanel Orientation="Horizontal" Spacing="16" Margin="0,4,0,0">
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="ID:" FontSize="11" Foreground="{DynamicResource SystemBaseMediumBrush}" />
            <TextBlock Text="{Binding TaskExecution.TaskId, FallbackValue='-'}" FontSize="11" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Started:" FontSize="11"
              Foreground="{DynamicResource SystemBaseMediumBrush}" />
            <TextBlock
              Text="{Binding TaskExecution.StartedAt, StringFormat='HH:mm:ss', FallbackValue='-'}"
              FontSize="11" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="Duration:" FontSize="11"
              Foreground="{DynamicResource SystemBaseMediumBrush}" />
            <TextBlock
              Text="{Binding TaskExecution.ExecutionTime, StringFormat='{}{0:mm\\:ss}', FallbackValue='-'}"
              FontSize="11" />
          </StackPanel>
          <!-- Velocity -->
          <StackPanel Orientation="Horizontal" Spacing="4"
            IsVisible="{Binding TaskExecution.Speed, Converter={x:Static ObjectConverters.IsNotNull}}">
            <TextBlock Text="Speed:" FontSize="11"
              Foreground="{DynamicResource SystemBaseMediumBrush}" />
            <TextBlock
              Text="{Binding TaskExecution.Speed, Converter={StaticResource ByteSpeedConverter}}"
              FontSize="11" FontWeight="SemiBold" />
          </StackPanel>
          <!-- ETC -->
          <StackPanel Orientation="Horizontal" Spacing="4">
            <TextBlock Text="ETC:" FontSize="11"
              Foreground="{DynamicResource SystemBaseMediumBrush}" />
            <TextBlock
              Text="{Binding TaskExecution.EstimatedTimeRemaining, StringFormat='{}{0:mm\\:ss}', FallbackValue='--:--'}"
              FontSize="11" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Tabs for Logs and Controls -->
    <Grid Grid.Row="2">
      <TabControl SelectedIndex="{Binding SelectedTabIndex}" Padding="0">
        <TabControl.Styles>
          <!-- Custom TabItem Style to match bottom panel -->
          <Style Selector="TabItem">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="MinHeight" Value="35" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundMutedBrush}" />
            <Setter Property="Template">
              <ControlTemplate>
                <Grid Background="Transparent">
                  <ContentPresenter Name="PART_ContentPresenter"
                    Content="{TemplateBinding Header}"
                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                    Margin="{TemplateBinding Padding}"
                    TextBlock.Foreground="{TemplateBinding Foreground}" />
                  <Border Name="SelectionIndicator"
                    Height="2"
                    Background="{DynamicResource BrandAccentBrush}"
                    VerticalAlignment="Bottom"
                    IsVisible="False" />
                </Grid>
              </ControlTemplate>
            </Setter>
          </Style>
          <Style Selector="TabItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
          </Style>
          <Style Selector="TabItem:selected /template/ Border#SelectionIndicator">
            <Setter Property="IsVisible" Value="True" />
          </Style>
          <Style Selector="TabItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
          </Style>

          <!-- Remove default TabControl padding and border -->
          <Style Selector="TabControl">
            <Setter Property="Padding" Value="0" />
          </Style>
          <Style Selector="TabControl /template/ Grid#PART_TabHeader">
            <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
          </Style>
        </TabControl.Styles>

        <!-- Manual Controls Tab -->
        <TabItem Header="Manual Controls">
          <ScrollViewer>
            <StackPanel Spacing="12" Margin="16">
              <!-- Status Message -->
              <Border Background="{DynamicResource AppBackgroundBrush}" CornerRadius="4" Padding="8"
                IsVisible="{Binding StatusMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="Status:" FontWeight="SemiBold" FontSize="12"
                    Foreground="{DynamicResource SystemBaseMediumBrush}" />
                  <TextBlock Text="{Binding StatusMessage}" FontSize="12"
                    Foreground="{DynamicResource SystemAccentBrush}" />
                </StackPanel>
              </Border>

              <!-- Socat Server Control -->
              <TextBlock Text="Socat Server Control" FontWeight="SemiBold" FontSize="14" />
              <!-- Serial Port Configuration Section -->
              <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Serial Port Configuration"
                      FontWeight="SemiBold"
                      FontSize="14" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Background="#4CAF50" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding IsSerialPortConnected}">
                        <TextBlock Text="Connected" FontSize="11" FontWeight="Medium" />
                      </Border>
                      <Border Background="#757575" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding !IsSerialPortConnected}">
                        <TextBlock Text="Disconnected" FontSize="11" FontWeight="Medium" />
                      </Border>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Apply serial port configuration from task's job profile"
                    FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" />
                  <Button Content="Apply Serial Configuration"
                    Command="{Binding ApplySerialConfigCommand}"
                    HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <!-- Socat Server Controls Section -->
              <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto,Auto">
                    <TextBlock Grid.Column="0" Text="Socat Server Controls" FontWeight="SemiBold"
                      FontSize="14" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,8,0">
                      <Border Background="#4CAF50" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding CanStopSocat}">
                        <TextBlock Text="Running" FontSize="11" FontWeight="Medium" />
                      </Border>
                      <Border Background="#757575" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding !CanStopSocat}">
                        <TextBlock Text="Stopped" FontSize="11" FontWeight="Medium" />
                      </Border>
                    </StackPanel>
                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                      <Border Background="#2196F3" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding IsSocatClientConnected}">
                        <TextBlock Text="Client Connected" FontSize="11" FontWeight="Medium" />
                      </Border>
                      <Border Background="#757575" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding !IsSocatClientConnected}">
                        <TextBlock Text="Client Disconnected" FontSize="11" FontWeight="Medium" />
                      </Border>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Manage socat TCP bridge server and client connection"
                    FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Content="Start Server" Command="{Binding StartSocatCommand}"
                      Margin="0,0,8,0" />
                    <Button Content="Stop Server" Command="{Binding StopSocatCommand}"
                      Margin="0,0,8,0" />
                    <Button Content="Kill Server" Command="{Binding KillSocatCommand}"
                      Margin="0,0,8,0" />
                    <Button Content="Connect Client" Command="{Binding ConnectSocatClientCommand}"
                      Margin="0,0,8,0" />
                    <Button Content="Disconnect Client"
                      Command="{Binding DisconnectSocatClientCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Power Supply Controls Section -->
              <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Power Supply Controls" FontWeight="SemiBold"
                      FontSize="14" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Background="#4CAF50" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding IsPowerConnected}">
                        <TextBlock Text="Connected" FontSize="11" FontWeight="Medium" />
                      </Border>
                      <Border Background="#757575" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding !IsPowerConnected}">
                        <TextBlock Text="Disconnected" FontSize="11" FontWeight="Medium" />
                      </Border>
                    </StackPanel>
                  </Grid>
                  <TextBlock Text="Connect to power supply and control PLC power state"
                    FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" />
                  <WrapPanel>
                    <Button Content="Connect" Command="{Binding ConnectPowerSupplyCommand}"
                      Margin="0,0,8,0" />
                    <Button Content="Disconnect" Command="{Binding DisconnectPowerSupplyCommand}"
                      Margin="0,0,8,0" />
                    <Button Content="Power ON" Command="{Binding PowerOnCommand}" Margin="0,0,8,0" />
                    <Button Content="Power OFF" Command="{Binding PowerOffCommand}" Margin="0,0,8,0" />
                    <Button Content="Power Cycle" Command="{Binding PowerCycleCommand}" />
                  </WrapPanel>
                </StackPanel>
              </Border>

              <!-- Manual Process Section -->
              <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="8">
                  <Grid ColumnDefinitions="*,Auto">
                    <TextBlock Grid.Column="0" Text="Manual Process (Steps 5-11)"
                      FontWeight="SemiBold" FontSize="14" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                      <Border Background="#4CAF50" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding CanStartManualProcess}">
                        <TextBlock Text="Ready" FontSize="11" FontWeight="Medium" />
                      </Border>
                      <Border Background="#FF9800" CornerRadius="10" Padding="8,3"
                        IsVisible="{Binding !CanStartManualProcess}">
                        <TextBlock Text="Not Ready" FontSize="11" FontWeight="Medium" />
                      </Border>
                    </StackPanel>
                  </Grid>
                  <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="#AAAAAA">
                    <Run
                      Text="Complete steps 1-4 manually (Serial Config, Socat Setup, Power Connect, Power ON), then click Start to automate steps 5-11 (Power Cycle → Memory Dump → Complete)." />
                  </TextBlock>

                  <!-- Progress Section -->
                  <StackPanel Spacing="4">
                    <Grid ColumnDefinitions="*,Auto">
                      <TextBlock Grid.Column="0" Text="{Binding CurrentProcessStep}" FontSize="12"
                        FontWeight="Medium" />
                      <TextBlock Grid.Column="1"
                        Text="{Binding ManualProcessProgress, StringFormat='{}{0:F1}%'}"
                        FontSize="12" FontWeight="SemiBold" Foreground="#2196F3" />
                    </Grid>
                    <ProgressBar Minimum="0" Maximum="100" Value="{Binding ManualProcessProgress}"
                      Height="6" />
                    <TextBlock
                      Text="{Binding EstimatedTimeRemaining, StringFormat='Estimated time remaining: {0:mm\\:ss}'}"
                      FontSize="11" Foreground="#AAAAAA" />
                  </StackPanel>

                  <Button Content="Start Manual Process"
                    Command="{Binding StartManualProcessCommand}"
                    HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <!-- Validation Section -->
              <Border Background="{DynamicResource PanelBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}" BorderThickness="1"
                CornerRadius="4"
                Padding="12">
                <StackPanel Spacing="8">
                  <TextBlock Text="Validation" FontWeight="SemiBold" FontSize="14" />
                  <TextBlock Text="Run validation checks on task configuration"
                    FontSize="12" Foreground="#AAAAAA" TextWrapping="Wrap" />
                  <Button Content="Run Validation"
                    Command="{Binding RunValidationCommand}"
                    HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

            </StackPanel>
          </ScrollViewer>
        </TabItem>
      </TabControl>


    </Grid>
  </Grid>

</UserControl>