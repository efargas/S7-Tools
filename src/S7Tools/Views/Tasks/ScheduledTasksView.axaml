<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Tasks"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Tasks.ScheduledTasksView"
             x:DataType="vm:ScheduledTasksViewModel">

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <!-- Header -->
      <TextBlock Text="Scheduled Tasks"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                 Margin="0,0,0,10" />

      <Border Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16">
        <StackPanel Spacing="16">
          <Grid Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Scheduled for Future Execution"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

            <TextBlock Grid.Column="1"
                       Text="{Binding Manager.ScheduledTasks.Count, StringFormat='{}{0} tasks'}"
                       FontSize="12"
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       VerticalAlignment="Center" />
          </Grid>

          <DataGrid ItemsSource="{Binding Manager.ScheduledTasks}"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                    GridLinesVisibility="Horizontal"
                    HeadersVisibility="Column"
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="True"
                    CanUserSortColumns="True"
                    IsReadOnly="True"
                    MaxHeight="400">
            <DataGrid.Columns>
              <DataGridTemplateColumn Header="Task ID" Width="180">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding TaskId}" 
                               TextTrimming="CharacterEllipsis" 
                               VerticalAlignment="Center" 
                               Margin="12,0"
                               ToolTip.Tip="{Binding TaskId}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTemplateColumn Header="Name" Width="1*" MinWidth="150" MaxWidth="300">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <TextBlock Text="{Binding JobName}" 
                               TextTrimming="CharacterEllipsis" 
                               VerticalAlignment="Center" 
                               Margin="12,0"
                               ToolTip.Tip="{Binding JobName}" />
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
              <DataGridTextColumn Header="Scheduled For" Binding="{Binding ScheduledTimeLocal, StringFormat='MM/dd HH:mm'}" Width="120" />
              <DataGridTextColumn Header="Time Until" Binding="{Binding TotalTime}" Width="100" />
              <DataGridTemplateColumn Header="Actions" Width="100">
                <DataGridTemplateColumn.CellTemplate>
                  <DataTemplate>
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                      <Button Command="{Binding $parent[UserControl].DataContext.Manager.StartTaskCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              ToolTip.Tip="Run task immediately">
                        <icons:Icon Value="fa-solid fa-play" Foreground="{DynamicResource SystemAccentColor}" />
                      </Button>
                      <Button Command="{Binding $parent[UserControl].DataContext.Manager.StopTaskCommand}"
                              CommandParameter="{Binding}"
                              Background="Transparent"
                              BorderThickness="0"
                              Padding="4"
                              ToolTip.Tip="Cancel / unschedule task">
                        <icons:Icon Value="fa-solid fa-ban" Foreground="{DynamicResource DangerForegroundBrush}" />
                      </Button>
                    </StackPanel>
                  </DataTemplate>
                </DataGridTemplateColumn.CellTemplate>
              </DataGridTemplateColumn>
            </DataGrid.Columns>
          </DataGrid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>