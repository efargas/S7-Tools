<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:S7Tools.ViewModels"
    mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="350"
    x:Class="S7Tools.Views.SplashScreenWindow"
    x:DataType="vm:SplashScreenViewModel"
    Width="600" Height="350"
    WindowStartupLocation="CenterScreen"
    SystemDecorations="None"
    Topmost="True"
    CanResize="False"
    Title="S7-Tools Starting...">

    <Border BorderThickness="1" BorderBrush="{DynamicResource ControlBackgroundBrush}" Background="{DynamicResource AppBackgroundBrush}">
        <Grid RowDefinitions="*,Auto,Auto" Margin="40">

            <!-- Logo / Title Area -->
            <StackPanel Grid.Row="0" VerticalAlignment="Center" HorizontalAlignment="Center"
                Spacing="20">
                <!-- Placeholder for Logo if we had one -->
                <TextBlock Text="S7-TOOLS"
                    FontSize="48"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextForegroundBrush}"
                    HorizontalAlignment="Center"
                    LetterSpacing="2" />
                <TextBlock Text="Advanced Bootloader &amp; Diagnostics"
                    FontSize="16"
                    Foreground="#AAAAAA"
                    HorizontalAlignment="Center" />
            </StackPanel>

            <!-- Progress Section -->
            <StackPanel Grid.Row="1" Spacing="10" Margin="0,40,0,0">
                <TextBlock Text="{Binding StatusText}"
                    Foreground="#DDDDDD"
                    FontSize="14"
                    HorizontalAlignment="Center" />

                <ProgressBar Value="{Binding Progress}"
                    Maximum="100"
                    Height="4"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Foreground="{DynamicResource BrandAccentBrush}" />
            </StackPanel>

            <!-- Footer -->
            <TextBlock Grid.Row="2"
                Text="v1.0.0"
                Foreground="#666666"
                FontSize="12"
                HorizontalAlignment="Right"
                Margin="0,20,0,0" />
        </Grid>
    </Border>
</Window>