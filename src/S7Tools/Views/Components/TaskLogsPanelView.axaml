<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:S7Tools.ViewModels.Components"
    xmlns:c="using:S7Tools.Views.Components"
    xmlns:models="using:S7Tools.Models"
    xmlns:converters="clr-namespace:S7Tools.Converters"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
    x:Class="S7Tools.Views.Components.TaskLogsPanelView"
    x:DataType="vm:TaskLogsPanelViewModel">

    <UserControl.Resources>
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- AutoScroll Toggle shared for both tabs (optional, or put inside each tab's header?)
             The original didn't have auto-scroll toggle on UI, but we added the property.
             Let's add a small toggle button in top right of the logs panel if desired, or just rely on default.
             The user didn't ask for a toggle button here, just "consistent AutoScroll behavior".
             So binding to the property (default true) is enough. The internal logic handles stickiness.
             I will just bind the property. -->

        <TabControl Grid.Row="1" Padding="0">
            <TabControl.Styles>
                <!-- Custom TabItem Style to match bottom panel -->
                <Style Selector="TabItem">
                    <Setter Property="FontSize" Value="11" />
                    <Setter Property="Padding" Value="12,8" />
                    <Setter Property="MinHeight" Value="35" />
                    <Setter Property="Background" Value="Transparent" />
                    <Setter Property="Foreground" Value="#858585" />
                    <Setter Property="Template">
                        <ControlTemplate>
                            <Grid Background="Transparent">
                                <ContentPresenter Name="PART_ContentPresenter"
                                    Content="{TemplateBinding Header}"
                                    ContentTemplate="{TemplateBinding HeaderTemplate}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    Margin="{TemplateBinding Padding}"
                                    TextBlock.Foreground="{TemplateBinding Foreground}" />
                                <Border Name="SelectionIndicator"
                                    Height="2"
                                    Background="#007ACC"
                                    VerticalAlignment="Bottom"
                                    IsVisible="False" />
                            </Grid>
                        </ControlTemplate>
                    </Setter>
                </Style>
                <Style Selector="TabItem:selected">
                    <Setter Property="Foreground" Value="White" />
                </Style>
                <Style Selector="TabItem:selected /template/ Border#SelectionIndicator">
                    <Setter Property="IsVisible" Value="True" />
                </Style>
                <Style Selector="TabItem:pointerover">
                    <Setter Property="Foreground" Value="White" />
                </Style>

                <!-- Remove default TabControl padding and border -->
                <Style Selector="TabControl">
                    <Setter Property="Padding" Value="0" />
                </Style>
                <Style Selector="TabControl /template/ Grid#PART_TabHeader">
                    <Setter Property="Background" Value="#2D2D30" />
                </Style>
            </TabControl.Styles>

            <!-- Main Log Tab -->
            <TabItem Header="Main Log">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="160,80,*" Background="#2D2D30">
                        <TextBlock Grid.Column="0" Text="Timestamp" FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="#CCCCCC" Padding="8,4" />
                        <TextBlock Grid.Column="1" Text="Level" FontWeight="SemiBold" FontSize="12"
                            Foreground="#CCCCCC" Padding="8,4" />
                        <TextBlock Grid.Column="2" Text="Message" FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="#CCCCCC" Padding="8,4" />
                    </Grid>
                    <!-- Log List -->
                    <!-- Log List -->
                    <c:LogListControl Grid.Row="1"
                        ItemsSource="{Binding MainLogEntries}"
                        AutoScroll="{Binding AutoScroll, Mode=TwoWay}"
                        CopyCommand="{Binding CopyCommand}">
                        <c:LogListControl.ItemTemplate>
                            <DataTemplate DataType="models:LogEntry">
                                <Grid ColumnDefinitions="160,80,*">
                                    <TextBlock Grid.Column="0"
                                        Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}"
                                        FontSize="12" Padding="8,4" Foreground="#CCCCCC"
                                        VerticalAlignment="Top" />
                                    <Border Grid.Column="1"
                                        Background="{Binding Level, Converter={x:Static converters:ObjectConverters.LogLevelToBrush}}"
                                        CornerRadius="3" Margin="8,4" Padding="4,2"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Level}" Foreground="White"
                                            FontSize="10"
                                            FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedMessage}"
                                        FontSize="12" Padding="8,4" TextWrapping="Wrap"
                                        Foreground="#CCCCCC"
                                        VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </c:LogListControl.ItemTemplate>
                    </c:LogListControl>
                </Grid>
            </TabItem>

            <!-- Socat Log Tab -->
            <TabItem Header="Socat Log">
                <Grid RowDefinitions="Auto,*">
                    <!-- Header -->
                    <Grid Grid.Row="0" ColumnDefinitions="160,80,*" Background="#2D2D30">
                        <TextBlock Grid.Column="0" Text="Timestamp" FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="#CCCCCC" Padding="8,4" />
                        <TextBlock Grid.Column="1" Text="Level" FontWeight="SemiBold" FontSize="12"
                            Foreground="#CCCCCC" Padding="8,4" />
                        <TextBlock Grid.Column="2" Text="Message" FontWeight="SemiBold"
                            FontSize="12"
                            Foreground="#CCCCCC" Padding="8,4" />
                    </Grid>
                    <!-- Log List -->
                    <!-- Log List -->
                    <c:LogListControl Grid.Row="1"
                        ItemsSource="{Binding ProcessLogEntries}"
                        AutoScroll="{Binding AutoScroll, Mode=TwoWay}"
                        CopyCommand="{Binding CopyCommand}">
                        <c:LogListControl.ItemTemplate>
                            <DataTemplate DataType="models:LogEntry">
                                <Grid ColumnDefinitions="160,80,*">
                                    <TextBlock Grid.Column="0"
                                        Text="{Binding Timestamp, StringFormat=yyyy-MM-dd HH:mm:ss.fff}"
                                        FontSize="12" Padding="8,4" Foreground="#CCCCCC"
                                        VerticalAlignment="Top" />
                                    <Border Grid.Column="1"
                                        Background="{Binding Level, Converter={x:Static converters:ObjectConverters.LogLevelToBrush}}"
                                        CornerRadius="3" Margin="8,4" Padding="4,2"
                                        VerticalAlignment="Top"
                                        HorizontalAlignment="Left">
                                        <TextBlock Text="{Binding Level}" Foreground="White"
                                            FontSize="10"
                                            FontWeight="SemiBold" />
                                    </Border>
                                    <TextBlock Grid.Column="2" Text="{Binding FormattedMessage}"
                                        FontSize="12" Padding="8,4" TextWrapping="Wrap"
                                        Foreground="#CCCCCC"
                                        VerticalAlignment="Top" />
                                </Grid>
                            </DataTemplate>
                        </c:LogListControl.ItemTemplate>
                    </c:LogListControl>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>