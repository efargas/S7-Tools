<UserControl xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:S7Tools.ViewModels.Settings"
    xmlns:icons="using:Projektanker.Icons.Avalonia"
    xmlns:system="clr-namespace:System;assembly=mscorlib"
    mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
    x:Class="S7Tools.Views.Settings.LoggingSettingsView"
    x:DataType="vm:LoggingSettingsViewModel"
    Background="{DynamicResource AppBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <!-- Header -->
            <TextBlock Text="Logging Settings"
                FontSize="24"
                FontWeight="Bold"
                Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                Margin="0,0,0,10" />

            <!-- Logging Settings Section -->
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Logging Configuration"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <!-- Default Log Path -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0"
                            Text="Default Log Path:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBox Grid.Column="1" Grid.Row="0"
                            Text="{Binding DefaultLogPath}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Margin="8,0" />

                        <Button Grid.Column="2" Grid.Row="0"
                            Content="Browse..."
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            BorderThickness="0"
                            Padding="12,4"
                            Margin="4,0"
                            Command="{Binding BrowseDefaultLogPathCommand}" />

                        <Button Grid.Column="3" Grid.Row="0"
                            Background="Transparent"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="12,4"
                            Margin="4,0"
                            ToolTip.Tip="Open in Explorer"
                            Command="{Binding OpenDefaultLogPathCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:Icon Value="fa-solid fa-external-link-alt" Width="14"
                                    Height="14" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3"
                            Text="Directory where log files will be stored by default"
                            FontSize="11"
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            Margin="8,4,0,0" />
                    </Grid>

                    <!-- Export Path -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Column="0" Grid.Row="0"
                            Text="Export Path:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBox Grid.Column="1" Grid.Row="0"
                            Text="{Binding ExportPath}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Margin="8,0" />

                        <Button Grid.Column="2" Grid.Row="0"
                            Content="Browse..."
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            BorderThickness="0"
                            Padding="12,4"
                            Margin="4,0"
                            Command="{Binding BrowseExportPathCommand}" />

                        <Button Grid.Column="3" Grid.Row="0"
                            Background="Transparent"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="12,4"
                            Margin="4,0"
                            ToolTip.Tip="Open in Explorer"
                            Command="{Binding OpenExportPathCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <icons:Icon Value="fa-solid fa-external-link-alt" Width="14"
                                    Height="14" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>

                        <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="3"
                            Text="Directory where exported log files will be saved"
                            FontSize="11"
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            Margin="8,4,0,0" />
                    </Grid>

                    <!-- Log Level -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="Minimum Log Level:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                            ItemsSource="{Binding LogLevels}"
                            SelectedItem="{Binding MinimumLogLevel}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Margin="8,0" />

                        <TextBlock Grid.Column="2"
                            Text="Only log messages at this level or higher will be recorded"
                            FontSize="11"
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="8,0" />
                    </Grid>

                    <!-- Auto-scroll -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="Auto-scroll:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <CheckBox Grid.Column="1"
                            IsChecked="{Binding AutoScrollLogs}"
                            Content="Automatically scroll to newest log entries"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            Margin="8,0" />
                    </Grid>

                    <!-- Rolling Log Files -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="Rolling Log Files:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <CheckBox Grid.Column="1"
                            IsChecked="{Binding EnableRollingLogs}"
                            Content="Create new log file each day (MainLog_YYYY-MM-DD_HH-mm-ss.log)"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            Margin="8,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Display Settings Section -->
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Display Options"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <!-- Show Timestamp -->
                    <CheckBox IsChecked="{Binding ShowTimestampInLogs}"
                        Content="Show timestamp in log entries"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <!-- Show Category -->
                    <CheckBox IsChecked="{Binding ShowCategoryInLogs}"
                        Content="Show category in log entries"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <!-- Show Log Level -->
                    <CheckBox IsChecked="{Binding ShowLogLevelInLogs}"
                        Content="Show log level badges in log entries"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <!-- Font Size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="Font Size:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <ComboBox Grid.Column="1"
                            ItemsSource="{Binding AvailableFontSizes}"
                            SelectedItem="{Binding LogViewerFontSize}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Margin="8,0" />

                        <TextBlock Grid.Column="2"
                            Text="Font size for log viewer text (10-24pt)"
                            FontSize="11"
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="8,0" />
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Serilog Configuration Section -->
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Serilog Configuration"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <!-- Max File Size -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="Max File Size:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBox Grid.Column="1"
                            Text="{Binding MaxLogFileSizeMb}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Margin="8,0" />

                        <TextBlock Grid.Column="2"
                            Text="Maximum size of a single log file before rotation (10 MB)"
                            FontSize="11"
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="8,0" />
                    </Grid>

                    <!-- Max Files -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="200" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                            Text="Max Retained Files:"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            VerticalAlignment="Center" />

                        <TextBox Grid.Column="1"
                            Text="{Binding MaxRetainedLogFiles}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            Margin="8,0" />

                        <TextBlock Grid.Column="2"
                            Text="Maximum number of rotated log files to keep (5 files)"
                            FontSize="11"
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            VerticalAlignment="Center"
                            Margin="8,0" />
                    </Grid>

                    <!-- File Logging Info -->
                    <TextBlock Text="Note: Serilog file rotation is configured automatically based on application settings"
                        FontSize="11"
                        Foreground="{DynamicResource TextForegroundMutedBrush}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Operation Logging Section -->
            <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Operation Logging"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <CheckBox IsChecked="{Binding LogProfileOperations}"
                        Content="Log profile CRUD operations"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <CheckBox IsChecked="{Binding LogModbusOperations}"
                        Content="Log individual Modbus TCP operations (Debug)"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <CheckBox IsChecked="{Binding LogConnectionStateChanges}"
                        Content="Log PLC connection state transitions"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <CheckBox IsChecked="{Binding LogPowerStateChanges}"
                        Content="Log power supply state transitions"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>