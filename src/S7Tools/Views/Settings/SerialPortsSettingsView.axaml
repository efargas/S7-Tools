<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Settings"
             xmlns:conv="using:S7Tools.Converters"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="using:S7Tools.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Settings.SerialPortsSettingsView"
             x:DataType="vm:SerialPortsSettingsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Styles>
    <StyleInclude Source="/Styles/PropertyStyles.axaml" />
  </UserControl.Styles>

  <UserControl.Resources>
    <conv:BooleanToInverseBooleanConverter x:Key="InvBool" />
  </UserControl.Resources>

  <ScrollViewer>
    <StackPanel Margin="20" Spacing="12">
      <!-- Header -->
      <TextBlock Text="Serial Ports Settings"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                 Margin="0,0,0,10" />

      <!-- Port Discovery Section -->
      <Border Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16"
              DataContext="{Binding PortScanner}">
        <controls:SerialPortDiscoveryControl Height="210" />
      </Border>

      <!-- Port Test Section -->
      <Border Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16"
              DataContext="{Binding PortScanner}">
        <StackPanel Spacing="12">
          <TextBlock Text="Port Testing"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="150" />
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Selected Port:"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       VerticalAlignment="Center" />

            <TextBlock Grid.Column="1"
                       Text="{Binding SelectedPort.PortName, FallbackValue='No port selected', TargetNullValue='No port selected'}"
                       Foreground="{DynamicResource BrandAccentBrush}"
                       FontWeight="SemiBold"
                       VerticalAlignment="Center"
                       Margin="8,0" />

            <Button Grid.Column="2"
                    Width="140"
                    Height="34"
                    Command="{Binding TestSelectedPortCommand}"
                    Background="{DynamicResource ButtonBackgroundBrush}"
                    Foreground="{DynamicResource TextForegroundBrush}">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <icons:Icon Value="fa-solid fa-vial" Width="14" Height="14" />
                <TextBlock Text="Test Port" />
              </StackPanel>
            </Button>
          </Grid>

          <Border Background="{DynamicResource AppBackgroundBrush}"
                  BorderBrush="{DynamicResource ControlBorderBrush}"
                  BorderThickness="1"
                  CornerRadius="3"
                  Padding="12"
                  MinHeight="80">
            <StackPanel Spacing="6">
              <TextBlock Text="Test Result:"
                         Foreground="{DynamicResource BrandAccentBrush}"
                         FontSize="12"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding SelectedPort.LastTestResult, FallbackValue='No test performed yet', TargetNullValue='No test performed yet'}"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         FontSize="12"
                         TextWrapping="Wrap" />
              <TextBlock Text="{Binding SelectedPort.LastTested, StringFormat='Last tested: {0:yyyy-MM-dd HH:mm:ss}', FallbackValue='Not tested yet', TargetNullValue='Not tested yet'}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="11"
                         Margin="0,4,0,0" />
            </StackPanel>
          </Border>

          <TextBlock Text="Select a port from the discovery list above and click 'Test Port' to verify accessibility and perform basic communication tests"
                     FontSize="11"
                     Foreground="{DynamicResource TextForegroundMutedBrush}"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>


      <!-- Status Section -->
      <Border Background="{DynamicResource PanelBackgroundBrush}"
              BorderBrush="{DynamicResource ControlBorderBrush}"
              BorderThickness="1"
              CornerRadius="4"
              Padding="16">
        <StackPanel Spacing="8">
          <TextBlock Text="Status Information"
                     FontSize="18"
                     FontWeight="SemiBold"
                     Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Profile Management:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding Profiles.Count, StringFormat='• {0} profiles loaded'}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="12" />
              <TextBlock Text="{Binding StatusMessage, StringFormat='• {0}'}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Port Discovery:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         FontWeight="SemiBold" />
              <TextBlock Text="{Binding PortCount, StringFormat='• {0} ports discovered'}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="12" />
              <TextBlock Text="{Binding SelectedPort, StringFormat='• Selected: {0}', FallbackValue='• No port selected'}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="12" />
            </StackPanel>
          </Grid>

          <!-- Loading Indicator -->
          <StackPanel Orientation="Horizontal"
                      Spacing="8"
                      IsVisible="{Binding IsLoading}">
            <icons:Icon Value="fa-solid fa-spinner"
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource ButtonBackgroundBrush}"
                        Classes="spin" />
            <TextBlock Text="Loading..."
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       FontSize="12" />
          </StackPanel>

          <!-- Status Message -->
          <TextBlock Text="{Binding StatusMessage}"
                     Foreground="{DynamicResource TextForegroundMutedBrush}"
                     FontSize="12"
                     TextWrapping="Wrap" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
