<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Settings"
             xmlns:conv="using:S7Tools.Converters"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             xmlns:controls="using:S7Tools.Views.Controls"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Settings.SerialPortsSettingsView"
             x:DataType="vm:SerialPortsSettingsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Styles>
    <StyleInclude Source="/Styles/PropertyStyles.axaml" />
  </UserControl.Styles>

  <UserControl.Resources>
    <conv:BooleanToInverseBooleanConverter x:Key="InvBool" />
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <!-- Header -->
      <TextBlock Text="Serial Ports Settings"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                 Margin="0,0,0,10" />

      <!-- Port Discovery Section -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-search" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="PORT DISCOVERY" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="0" Margin="24,16,24,24" DataContext="{Binding PortScanner}">
            <controls:SerialPortDiscoveryControl Height="210" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Port Test Section -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-vial" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="PORT TESTING" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="12" Margin="24,16,24,24" DataContext="{Binding PortScanner}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="Selected Port:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         VerticalAlignment="Center" />

              <TextBlock Grid.Column="1"
                         Text="{Binding SelectedPort.PortName, FallbackValue='No port selected', TargetNullValue='No port selected'}"
                         Foreground="{DynamicResource BrandAccentBrush}"
                         FontWeight="SemiBold"
                         VerticalAlignment="Center"
                         Margin="8,0" />

              <Button Grid.Column="2"
                      Width="110"
                      Height="34"
                      Command="{Binding TestSelectedPortCommand}"
                      Background="{DynamicResource ButtonBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundBrush}">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-vial" Width="14" Height="14" />
                  <TextBlock Text="Test Port" />
                </StackPanel>
              </Button>
            </Grid>

            <Border Background="{DynamicResource AppBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="3"
                    Padding="12"
                    MinHeight="80">
              <StackPanel Spacing="6">
                <TextBlock Text="Test Result:"
                           Foreground="{DynamicResource BrandAccentBrush}"
                           FontSize="12"
                           FontWeight="SemiBold" />
                <TextBlock Text="{Binding SelectedPort.LastTestResult, FallbackValue='No test performed yet', TargetNullValue='No test performed yet'}"
                           Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                           FontSize="12"
                           TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedPort.LastTested, StringFormat='Last tested: {0:yyyy-MM-dd HH:mm:ss}', FallbackValue='Not tested yet', TargetNullValue='Not tested yet'}"
                           Foreground="{DynamicResource TextForegroundMutedBrush}"
                           FontSize="11"
                           Margin="0,4,0,0" />
              </StackPanel>
            </Border>

            <TextBlock Text="Select a port from the discovery list above and click 'Test Port' to verify accessibility and perform basic communication tests"
                       FontSize="11"
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </Border>


    </StackPanel>
  </ScrollViewer>
</UserControl>
