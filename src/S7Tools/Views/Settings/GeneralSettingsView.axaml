<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Settings"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20">
            <!-- Header -->
            <TextBlock Text="General Settings" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}" 
                       Margin="0,0,0,10" />

            <!-- Actions Section -->
            <Border Background="{DynamicResource PanelBackgroundBrush}" 
                BorderBrush="{DynamicResource ControlBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Settings Management" 
                        FontSize="18" 
                        FontWeight="SemiBold" 
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- Save Settings -->
                        <Button Grid.Column="0"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            BorderThickness="0"
                            Padding="16,8"
                            Margin="0,0,8,0"
                            Command="{Binding SaveSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:Icon Value="fa-solid fa-save" Width="16" Height="16" />
                                <TextBlock Text="Save Settings" />
                            </StackPanel>
                        </Button>

                        <!-- Load Settings -->
                        <Button Grid.Column="1"
                            Background="{DynamicResource ButtonBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            BorderThickness="0"
                            Padding="16,8"
                            Margin="4,0"
                            Command="{Binding LoadSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:Icon Value="fa-solid fa-folder-open" Width="16" Height="16" />
                                <TextBlock Text="Load Settings" />
                            </StackPanel>
                        </Button>

                        <!-- Reset to Defaults -->
                        <Button Grid.Column="2"
                            Background="#D13438"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            BorderThickness="0"
                            Padding="16,8"
                            Margin="4,0"
                            Command="{Binding ResetSettingsCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:Icon Value="fa-solid fa-undo" Width="16" Height="16" />
                                <TextBlock Text="Reset Defaults" />
                            </StackPanel>
                        </Button>

                        <!-- Open Settings Folder -->
                        <Button Grid.Column="3"
                            Background="Transparent"
                            Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="1"
                            Padding="16,8"
                            Margin="8,0,0,0"
                            Command="{Binding OpenSettingsFolderCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <icons:Icon Value="fa-solid fa-folder" Width="16" Height="16" />
                                <TextBlock Text="Open Folder" />
                            </StackPanel>
                        </Button>
                    </Grid>

                    <!-- Status Text -->
                    <TextBlock Text="{Binding SettingsStatusMessage}"
                        Foreground="{DynamicResource TextForegroundMutedBrush}"
                        FontSize="12"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- Current Settings Info -->
            <Border Background="{DynamicResource PanelBackgroundBrush}" 
                BorderBrush="{DynamicResource ControlBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="4" 
                Padding="16">
                <StackPanel Spacing="8">
                    <TextBlock Text="Current Settings File" 
                        FontSize="18" 
                        FontWeight="SemiBold" 
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <TextBlock Text="{Binding CurrentSettingsFilePath}"
                        Foreground="{DynamicResource TextForegroundMutedBrush}"
                        FontSize="11"
                        TextWrapping="Wrap" />

                    <TextBlock 
                        Text="{Binding SettingsLastModified, StringFormat='Last modified: {0:yyyy-MM-dd HH:mm:ss}'}"
                        Foreground="{DynamicResource TextForegroundMutedBrush}"
                        FontSize="11" />
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="Memory Dump"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <StackPanel Spacing="4">
                        <TextBlock Text="Default Output Folder"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            FontSize="13" />
                        <TextBox Text="{Binding MemoryDumpDefaultFolder}"
                            Watermark="e.g. Resources/Dumps"
                            Background="{DynamicResource InputBackgroundBrush}"
                            Foreground="{DynamicResource TextForegroundBrush}"
                            BorderBrush="{DynamicResource ControlBorderBrush}" />
                        <TextBlock Text="Folder where dump files are saved. Relative paths are resolved from the application base directory."
                            Foreground="{DynamicResource TextForegroundMutedBrush}"
                            FontSize="11"
                            TextWrapping="Wrap" />
                    </StackPanel>

                    <Grid ColumnDefinitions="*,16,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Inter-Segment Delay (ms)"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                FontSize="13" />
                            <NumericUpDown Value="{Binding SegmentDumpDelayMs}"
                                Minimum="0" Maximum="60000" Increment="500"
                                FormatString="0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                            <TextBlock Text="Pause between successive segment dumps. Set 0 to disable."
                                Foreground="{DynamicResource TextForegroundMutedBrush}"
                                FontSize="11"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Inter-Iteration Delay (ms)"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                FontSize="13" />
                            <NumericUpDown Value="{Binding IterationDumpDelayMs}"
                                Minimum="0" Maximum="60000" Increment="500"
                                FormatString="0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                            <TextBlock Text="Pause between successive dump iterations (DumpCount &gt; 1). Set 0 to disable."
                                Foreground="{DynamicResource TextForegroundMutedBrush}"
                                FontSize="11"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="{DynamicResource PanelBackgroundBrush}"
                BorderBrush="{DynamicResource ControlBorderBrush}"
                BorderThickness="1"
                CornerRadius="4"
                Padding="16">
                <StackPanel Spacing="16">
                    <TextBlock Text="PLC Connection"
                        FontSize="18"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

                    <Grid ColumnDefinitions="*,16,*,16,*">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Connection Timeout (ms)"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                FontSize="13" />
                            <NumericUpDown Value="{Binding PlcConnectionTimeout}"
                                Minimum="100" Maximum="60000" Increment="500"
                                FormatString="0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="4">
                            <TextBlock Text="Read Timeout (ms)"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                FontSize="13" />
                            <NumericUpDown Value="{Binding PlcReadTimeout}"
                                Minimum="100" Maximum="60000" Increment="500"
                                FormatString="0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>

                        <StackPanel Grid.Column="4" Spacing="4">
                            <TextBlock Text="Retry Attempts"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                FontSize="13" />
                            <NumericUpDown Value="{Binding PlcRetryAttempts}"
                                Minimum="0" Maximum="10" Increment="1"
                                FormatString="0"
                                Background="{DynamicResource InputBackgroundBrush}"
                                Foreground="{DynamicResource TextForegroundBrush}"
                                BorderBrush="{DynamicResource ControlBorderBrush}" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>