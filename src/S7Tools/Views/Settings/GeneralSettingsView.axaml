<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Settings"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Settings.GeneralSettingsView"
             x:DataType="vm:GeneralSettingsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <!-- Header -->
            <TextBlock Text="General Settings" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}" 
                       Margin="0,0,0,10" />

      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-tasks" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="SETTINGS MANAGEMENT" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <!-- Toolbar Grid (Split CRUD and Other actions) -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <!-- Save Settings -->
                <Button Width="110" Height="34" Command="{Binding SaveSettingsCommand}" Background="#28A745" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-save" Width="14" Height="14" />
                    <TextBlock Text="Save" />
                  </StackPanel>
                </Button>

                <!-- Load Settings -->
                <Button Width="110" Height="34" Command="{Binding LoadSettingsCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-folder-open" Width="14" Height="14" />
                    <TextBlock Text="Load" />
                  </StackPanel>
                </Button>

                <!-- Reset to Defaults -->
                <Button Width="110" Height="34" Command="{Binding ResetSettingsCommand}" Background="#D13438" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-undo" Width="14" Height="14" />
                    <TextBlock Text="Reset" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <!-- Open Settings Folder -->
                <Button Width="110" Height="34" Command="{Binding OpenSettingsFolderCommand}" Background="Transparent" BorderBrush="{DynamicResource ControlBorderBrush}" Foreground="{DynamicResource TextForegroundSecondaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-folder" Width="14" Height="14" />
                    <TextBlock Text="Open Folder" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- Status Text -->
            <TextBlock Text="{Binding SettingsStatusMessage}"
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       FontSize="12"
                       TextWrapping="Wrap" />
          </StackPanel>
        </Expander>
      </Border>

      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-file-code" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="CURRENT SETTINGS FILE" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <TextBlock Text="{Binding CurrentSettingsFilePath}"
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       FontSize="11"
                       TextWrapping="Wrap" />

            <TextBlock Text="{Binding SettingsLastModified, StringFormat='Last modified: {0:yyyy-MM-dd HH:mm:ss}'}"
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       FontSize="11" />
          </StackPanel>
        </Expander>
      </Border>

      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-memory" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="MEMORY DUMP" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="16" Margin="24,16,24,24">
            <StackPanel Spacing="4">
              <TextBlock Text="Default Output Folder"
                         Foreground="{DynamicResource TextForegroundBrush}"
                         FontSize="13" />
              <TextBox Text="{Binding MemoryDumpDefaultFolder}"
                       Watermark="e.g. Resources/Dumps"
                       Background="{DynamicResource InputBackgroundBrush}"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       BorderBrush="{DynamicResource ControlBorderBrush}" />
              <TextBlock Text="Folder where dump files are saved. Relative paths are resolved from the application base directory."
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="11"
                         TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,16,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Inter-Segment Delay (ms)"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="13" />
                <NumericUpDown Value="{Binding SegmentDumpDelayMs}"
                               Minimum="0" Maximum="60000" Increment="500"
                               FormatString="0"
                               Background="{DynamicResource InputBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               BorderBrush="{DynamicResource ControlBorderBrush}" />
                <TextBlock Text="Pause between successive segment dumps. Set 0 to disable."
                           Foreground="{DynamicResource TextForegroundMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Inter-Iteration Delay (ms)"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="13" />
                <NumericUpDown Value="{Binding IterationDumpDelayMs}"
                               Minimum="0" Maximum="60000" Increment="500"
                               FormatString="0"
                               Background="{DynamicResource InputBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               BorderBrush="{DynamicResource ControlBorderBrush}" />
                <TextBlock Text="Pause between successive dump iterations (DumpCount > 1). Set 0 to disable."
                           Foreground="{DynamicResource TextForegroundMutedBrush}"
                           FontSize="11"
                           TextWrapping="Wrap" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-plug" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="PLC CONNECTION" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="16" Margin="24,16,24,24">
            <Grid ColumnDefinitions="*,16,*,16,*">
              <StackPanel Grid.Column="0" Spacing="4">
                <TextBlock Text="Connection Timeout (ms)"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="13" />
                <NumericUpDown Value="{Binding PlcConnectionTimeout}"
                               Minimum="100" Maximum="60000" Increment="500"
                               FormatString="0"
                               Background="{DynamicResource InputBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               BorderBrush="{DynamicResource ControlBorderBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="2" Spacing="4">
                <TextBlock Text="Read Timeout (ms)"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="13" />
                <NumericUpDown Value="{Binding PlcReadTimeout}"
                               Minimum="100" Maximum="60000" Increment="500"
                               FormatString="0"
                               Background="{DynamicResource InputBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               BorderBrush="{DynamicResource ControlBorderBrush}" />
              </StackPanel>

              <StackPanel Grid.Column="4" Spacing="4">
                <TextBlock Text="Retry Attempts"
                           Foreground="{DynamicResource TextForegroundBrush}"
                           FontSize="13" />
                <NumericUpDown Value="{Binding PlcRetryAttempts}"
                               Minimum="0" Maximum="10" Increment="1"
                               FormatString="0"
                               Background="{DynamicResource InputBackgroundBrush}"
                               Foreground="{DynamicResource TextForegroundBrush}"
                               BorderBrush="{DynamicResource ControlBorderBrush}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>