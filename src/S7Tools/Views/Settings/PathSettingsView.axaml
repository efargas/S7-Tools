<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Settings"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="800"
             x:Class="S7Tools.Views.Settings.PathSettingsView"
             x:DataType="vm:PathSettingsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <!-- Header -->
            <TextBlock Text="Paths Settings" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}" 
                       Margin="0,0,0,10" />

            <!-- Sub header info -->
            <TextBlock Text="Configure the locations where different profile types and settings are stored."
                       FontSize="13"
                       Foreground="{DynamicResource TextForegroundMutedBrush}"
                       TextWrapping="Wrap" />

      <!-- Serial Ports Profiles Path -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-folder-tree" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="SERIAL PORTS PROFILES" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Column="0" Grid.Row="0"
                         Text="Path:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         VerticalAlignment="Center" />

              <TextBox Grid.Column="1" Grid.Row="0"
                       Text="{Binding SerialProfilesPath}"
                       IsReadOnly="True"
                       Background="{DynamicResource ControlBackgroundBrush}"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       BorderBrush="{DynamicResource ControlBorderBrush}"
                       Margin="8,0" />

              <Button Grid.Column="2" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding BrowseSerialProfilesPathCommand}"
                      Background="{DynamicResource ButtonBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-folder-open" Width="14" Height="14" />
                  <TextBlock Text="Browse" />
                </StackPanel>
              </Button>

              <Button Grid.Column="3" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding OpenSerialProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-external-link-alt" Width="14" Height="14" />
                  <TextBlock Text="Open" />
                </StackPanel>
              </Button>

              <Button Grid.Column="4" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding ResetSerialProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-undo" Width="14" Height="14" />
                  <TextBlock Text="Reset" />
                </StackPanel>
              </Button>

              <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4"
                         Text="Location of the serial port profile JSON configuration files"
                         FontSize="11"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         Margin="8,4,0,0" />
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Socat Profiles Path -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-network-wired" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="SOCAT PROFILES" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Column="0" Grid.Row="0"
                         Text="Path:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         VerticalAlignment="Center" />

              <TextBox Grid.Column="1" Grid.Row="0"
                       Text="{Binding SocatProfilesPath}"
                       IsReadOnly="True"
                       Background="{DynamicResource ControlBackgroundBrush}"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       BorderBrush="{DynamicResource ControlBorderBrush}"
                       Margin="8,0" />

              <Button Grid.Column="2" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding BrowseSocatProfilesPathCommand}"
                      Background="{DynamicResource ButtonBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-folder-open" Width="14" Height="14" />
                  <TextBlock Text="Browse" />
                </StackPanel>
              </Button>

              <Button Grid.Column="3" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding OpenSocatProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-external-link-alt" Width="14" Height="14" />
                  <TextBlock Text="Open" />
                </StackPanel>
              </Button>

              <Button Grid.Column="4" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding ResetSocatProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-undo" Width="14" Height="14" />
                  <TextBlock Text="Reset" />
                </StackPanel>
              </Button>

              <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4"
                         Text="Location of the socat server profile JSON configuration files"
                         FontSize="11"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         Margin="8,4,0,0" />
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Power Supply Profiles Path -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-bolt" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="POWER SUPPLY PROFILES" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Column="0" Grid.Row="0"
                         Text="Path:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         VerticalAlignment="Center" />

              <TextBox Grid.Column="1" Grid.Row="0"
                       Text="{Binding PowerSupplyProfilesPath}"
                       IsReadOnly="True"
                       Background="{DynamicResource ControlBackgroundBrush}"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       BorderBrush="{DynamicResource ControlBorderBrush}"
                       Margin="8,0" />

              <Button Grid.Column="2" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding BrowsePowerSupplyProfilesPathCommand}"
                      Background="{DynamicResource ButtonBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-folder-open" Width="14" Height="14" />
                  <TextBlock Text="Browse" />
                </StackPanel>
              </Button>

              <Button Grid.Column="3" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding OpenPowerSupplyProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-external-link-alt" Width="14" Height="14" />
                  <TextBlock Text="Open" />
                </StackPanel>
              </Button>

              <Button Grid.Column="4" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding ResetPowerSupplyProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-undo" Width="14" Height="14" />
                  <TextBlock Text="Reset" />
                </StackPanel>
              </Button>

              <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4"
                         Text="Location of the power supply profile JSON configuration files"
                         FontSize="11"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         Margin="8,4,0,0" />
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-microchip" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="MEMORY REGIONS PROFILES" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>

              <TextBlock Grid.Column="0" Grid.Row="0"
                         Text="Path:"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         VerticalAlignment="Center" />

              <TextBox Grid.Column="1" Grid.Row="0"
                       Text="{Binding MemoryRegionProfilesPath}"
                       IsReadOnly="True"
                       Background="{DynamicResource ControlBackgroundBrush}"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       BorderBrush="{DynamicResource ControlBorderBrush}"
                       Margin="8,0" />

              <Button Grid.Column="2" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding BrowseMemoryRegionProfilesPathCommand}"
                      Background="{DynamicResource ButtonBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-folder-open" Width="14" Height="14" />
                  <TextBlock Text="Browse" />
                </StackPanel>
              </Button>

              <Button Grid.Column="3" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding OpenMemoryRegionProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-external-link-alt" Width="14" Height="14" />
                  <TextBlock Text="Open" />
                </StackPanel>
              </Button>

              <Button Grid.Column="4" Grid.Row="0"
                      Width="110" Height="34"
                      Command="{Binding ResetMemoryRegionProfilesPathCommand}"
                      Background="Transparent"
                      BorderBrush="{DynamicResource ControlBorderBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      Margin="4,0,0,0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                  <icons:Icon Value="fa-solid fa-undo" Width="14" Height="14" />
                  <TextBlock Text="Reset" />
                </StackPanel>
              </Button>

              <TextBlock Grid.Column="1" Grid.Row="1" Grid.ColumnSpan="4"
                         Text="Location of the memory mapping profile JSON configuration files"
                         FontSize="11"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         Margin="8,4,0,0" />
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

            <!-- Status Message -->
            <TextBlock Text="{Binding StatusMessage}" 
                       Foreground="{DynamicResource BrandAccentBrush}" 
                       FontWeight="SemiBold"
                       FontSize="13" 
                       HorizontalAlignment="Center"
                       TextWrapping="Wrap" />

        </StackPanel>
    </ScrollViewer>
</UserControl>