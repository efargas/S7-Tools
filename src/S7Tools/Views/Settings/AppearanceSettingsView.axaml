<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Settings"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Settings.AppearanceSettingsView"
             x:DataType="vm:AppearanceSettingsViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

    <ScrollViewer>
        <StackPanel Margin="20" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">
            <!-- Header -->
            <TextBlock Text="Appearance Settings" 
                       FontSize="24" 
                       FontWeight="Bold" 
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}" 
                       HorizontalAlignment="Center"
                       Margin="0,0,0,20" />

            <!-- Coming Soon Message -->
            <Border Background="{DynamicResource PanelBackgroundBrush}" 
                    BorderBrush="{DynamicResource ControlBorderBrush}" 
                    BorderThickness="1" 
                    CornerRadius="8" 
                    Padding="40"
                    MaxWidth="400">
                <StackPanel Spacing="16" HorizontalAlignment="Center">
                    <TextBlock Text="🎨" 
                               FontSize="48" 
                               HorizontalAlignment="Center" />
                    
                    <TextBlock Text="Coming Soon" 
                               FontSize="20" 
                               FontWeight="SemiBold" 
                               Foreground="{DynamicResource TextForegroundSecondaryBrush}" 
                               HorizontalAlignment="Center" />
                    
                    <TextBlock Text="Theme and appearance customization options will be available in a future update."
                               FontSize="14"
                               Foreground="{DynamicResource TextForegroundMutedBrush}"
                               TextWrapping="Wrap"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>