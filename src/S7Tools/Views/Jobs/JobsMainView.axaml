<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Jobs"
             xmlns:views="using:S7Tools.Views.Jobs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="S7Tools.Views.Jobs.JobsMainView"
             x:DataType="vm:JobsManagementViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <!-- Content switching based on sidebar selection - follows Settings pattern exactly -->
  <ContentControl Content="{Binding SelectedContentViewModel}" />
</UserControl>
