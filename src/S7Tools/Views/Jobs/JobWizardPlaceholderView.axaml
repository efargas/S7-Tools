<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Jobs"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Jobs.JobWizardPlaceholderView"
             x:DataType="vm:JobWizardPlaceholderViewModel"
             Background="#1E1E1E">

  <ScrollViewer>
    <StackPanel Margin="40" Spacing="20" HorizontalAlignment="Center" VerticalAlignment="Center">

      <!-- Title -->
      <TextBlock Text="{Binding Title}"
                 FontSize="28"
                 FontWeight="Bold"
                 Foreground="#CCCCCC"
                 HorizontalAlignment="Center"
                 TextAlignment="Center" />

      <!-- Message -->
      <TextBlock Text="{Binding Message}"
                 FontSize="16"
                 Foreground="#FFFFFF"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 MaxWidth="600" />

      <!-- Placeholder Content -->
      <Border Background="#252526"
              BorderBrush="#464647"
              BorderThickness="1"
              CornerRadius="8"
              Padding="40"
              Margin="0,20,0,0">
        <StackPanel Spacing="16">

          <TextBlock Text="🚧 Under Construction 🚧"
                     FontSize="20"
                     FontWeight="SemiBold"
                     Foreground="#FFA500"
                     HorizontalAlignment="Center" />

          <TextBlock Text="This wizard interface is currently being developed. In the meantime, you can use the main Jobs management interface to:"
                     FontSize="14"
                     Foreground="#CCCCCC"
                     TextWrapping="Wrap"
                     TextAlignment="Center" />

          <StackPanel Spacing="8" Margin="0,10,0,0">
            <TextBlock Text="• Create new job profiles using the Create button"
                       FontSize="13"
                       Foreground="#FFFFFF" />
            <TextBlock Text="• Edit existing profiles using the Edit button"
                       FontSize="13"
                       Foreground="#FFFFFF" />
            <TextBlock Text="• Duplicate profiles for quick setup"
                       FontSize="13"
                       Foreground="#FFFFFF" />
            <TextBlock Text="• Import/Export job configurations"
                       FontSize="13"
                       Foreground="#FFFFFF" />
          </StackPanel>

          <TextBlock Text="Please return to the Main View to access these features."
                     FontSize="14"
                     FontWeight="SemiBold"
                     Foreground="#0E639C"
                     HorizontalAlignment="Center"
                     Margin="0,20,0,0" />
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
