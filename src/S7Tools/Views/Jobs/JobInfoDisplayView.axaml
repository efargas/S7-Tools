<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:S7Tools.ViewModels.Jobs"
             xmlns:profiles="clr-namespace:S7Tools.ViewModels.Profiles"
             xmlns:converters="clr-namespace:S7Tools.Converters"
             xmlns:controls="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="600"
             x:Class="S7Tools.Views.Jobs.JobInfoDisplayView"
             x:DataType="vm:JobInfoDisplayViewModel"
             Background="Transparent">

  <Design.DataContext>
    <vm:JobInfoDisplayViewModel />
  </Design.DataContext>

  <UserControl.Styles>
    <!-- Property table styling for better appearance -->
    <Style Selector="Border.PropertyTable">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Margin" Value="0,4" />
    </Style>

    <!-- Property header styling -->
    <Style Selector="Border.PropertyHeader">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,4" />
    </Style>

    <Style Selector="TextBlock.PropertyHeaderText">
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- Property row styling with alternating background -->
    <Style Selector="Border.PropertyRow">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderBrush" Value="{DynamicResource ControlBorderBrush}" />
      <Setter Property="BorderThickness" Value="0,0,0,1" />
      <Setter Property="Padding" Value="8,4" />
      <Setter Property="MinHeight" Value="24" />
    </Style>

    <Style Selector="Border.PropertyRow:nth-child(even)">
      <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
    </Style>

    <!-- Property text styling -->
    <Style Selector="TextBlock.PropertyName">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="TextBlock.PropertyValue">
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

        <!-- Expander and section styling remains the same -->
    <Style Selector="TextBlock.InfoLabel">
      <Setter Property="FontWeight" Value="Medium" />
      <Setter Property="Margin" Value="0,2" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundSecondaryBrush}" />
    </Style>

    <Style Selector="TextBlock.InfoValue">
      <Setter Property="Margin" Value="8,2,0,2" />
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
    </Style>


  </UserControl.Styles>

  <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="0" Margin="0" Transitions="">

      <!-- Job Basic Information -->
      <Border Classes="ProfileSection">
        <Expander IsExpanded="True" x:Name="JobInfoExpander">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-info-circle" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="JOB DETAILS" />
            </Grid>
          </Expander.Header>
          <StackPanel Spacing="4">
            <TextBlock Text="{Binding JobBasicInfo}"
                       TextWrapping="Wrap"
                       Foreground="{DynamicResource TextForegroundBrush}"
                       Margin="0" />
          </StackPanel>
        </Expander>
      </Border>

      <!-- Missing Profiles Warning -->
      <Border Classes="WarningSection"
              IsVisible="{Binding HasMissingProfiles}">
        <Expander IsExpanded="False" x:Name="WarningExpander">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-exclamation-triangle" Foreground="#D13438" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="MISSING PROFILES" Foreground="#D13438" />
            </Grid>
          </Expander.Header>
          <ItemsControl ItemsSource="{Binding MissingProfileWarnings}">
            <ItemsControl.ItemTemplate>
              <DataTemplate>
                <TextBlock Text="{Binding}"
                           Foreground="#D13438"
                           Margin="0,2" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </Expander>
      </Border>

      <!-- Serial Profile Details -->
      <Border Classes="ProfileSection"
              IsVisible="{Binding SerialProfileDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Expander IsExpanded="False" x:Name="SerialExpander">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-plug" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="SERIAL PORT" />
            </Grid>
          </Expander.Header>
          <ContentControl Content="{Binding SerialProfileDetails}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="profiles:IProfileDetailsViewModel">
                <StackPanel Spacing="4">
                  <!-- Profile Name -->
                  <DockPanel Margin="0,4">
                    <TextBlock Classes="InfoLabel" Text="Profile:" />
                    <TextBlock Classes="InfoValue" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                  </DockPanel>

                  <!-- All Properties in one section -->
                  <Border Classes="PropertyTable">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding BasicProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                  <!-- Configuration Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding ConfigurationProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding ConfigurationProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border><!-- Advanced Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding AdvancedProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding AdvancedProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border></StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Expander>
      </Border>

      <!-- Socat Profile Details -->
      <Border Classes="ProfileSection"
              IsVisible="{Binding SocatProfileDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Expander IsExpanded="False" x:Name="SocatExpander">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-bridge" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="SOCAT BRIDGE" />
            </Grid>
          </Expander.Header>
          <ContentControl Content="{Binding SocatProfileDetails}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="profiles:IProfileDetailsViewModel">
                <StackPanel Spacing="4">
                  <!-- Profile Name -->
                  <DockPanel Margin="0,4">
                    <TextBlock Classes="InfoLabel" Text="Profile:" />
                    <TextBlock Classes="InfoValue" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                  </DockPanel>

                  <!-- All Properties in one section -->
                  <Border Classes="PropertyTable">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding BasicProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                  <!-- Configuration Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding ConfigurationProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding ConfigurationProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border><!-- Advanced Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding AdvancedProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding AdvancedProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border></StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Expander>
      </Border>

      <!-- Power Supply Profile Details -->
      <Border Classes="ProfileSection"
              IsVisible="{Binding PowerSupplyProfileDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Expander IsExpanded="False" x:Name="PowerExpander">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-bolt" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="POWER SUPPLY" />
            </Grid>
          </Expander.Header>
          <ContentControl Content="{Binding PowerSupplyProfileDetails}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="profiles:IProfileDetailsViewModel">
                <StackPanel Spacing="8">
                  <!-- Profile Name -->
                  <DockPanel Margin="0,4">
                    <TextBlock Classes="InfoLabel" Text="Profile:" />
                    <TextBlock Classes="InfoValue" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                  </DockPanel>

                  <!-- All Properties in one section -->
                  <Border Classes="PropertyTable">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding BasicProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                  <!-- Configuration Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding ConfigurationProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding ConfigurationProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border><!-- Advanced Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding AdvancedProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding AdvancedProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border></StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Expander>
      </Border>

      <!-- Memory Region Details -->
      <Border Classes="ProfileSection"
              IsVisible="{Binding MemoryRegionProfileDetails, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Expander IsExpanded="False" x:Name="MemoryExpander">
          <Expander.Header>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-microchip" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="MEMORY REGION" />
            </Grid>
          </Expander.Header>
          <ContentControl Content="{Binding MemoryRegionProfileDetails}">
            <ContentControl.ContentTemplate>
              <DataTemplate x:DataType="profiles:IProfileDetailsViewModel">
                <StackPanel Spacing="8">
                  <!-- Profile Name -->
                  <DockPanel Margin="0,4">
                    <TextBlock Classes="InfoLabel" Text="Profile:" />
                    <TextBlock Classes="InfoValue" Text="{Binding ProfileName}" FontWeight="SemiBold" />
                  </DockPanel>

                  <!-- All Properties in one section -->
                  <Border Classes="PropertyTable">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding BasicProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border>

                  <!-- Configuration Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding ConfigurationProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding ConfigurationProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border><!-- Advanced Properties -->
                  <Border Classes="PropertyTable"
                          IsVisible="{Binding AdvancedProperties.Count, Converter={x:Static converters:ObjectConverters.CountToVisibility}}"
                          Margin="0,8,0,0">
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                      <StackPanel>
                        <!-- Header -->
                        <Border Classes="PropertyHeader">
                          <Grid>
                            <Grid.ColumnDefinitions>
                              <ColumnDefinition Width="180" />
                              <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Setting" Classes="PropertyHeaderText" />
                            <TextBlock Grid.Column="1" Text="Value" Classes="PropertyHeaderText" />
                          </Grid>
                        </Border>

                        <!-- Property Rows -->
                        <ItemsControl ItemsSource="{Binding AdvancedProperties}">
                          <ItemsControl.ItemTemplate>
                            <DataTemplate>
                              <Border Classes="PropertyRow">
                                <Grid>
                                  <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="180" />
                                    <ColumnDefinition Width="*" />
                                  </Grid.ColumnDefinitions>
                                  <TextBlock Grid.Column="0"
                                             Text="{Binding Label}"
                                             Classes="PropertyName" />
                                  <TextBlock Grid.Column="1"
                                             Text="{Binding Value}"
                                             Classes="PropertyValue"
                                             ToolTip.Tip="{Binding Tooltip}" />
                                </Grid>
                              </Border>
                            </DataTemplate>
                          </ItemsControl.ItemTemplate>
                        </ItemsControl>
                      </StackPanel>
                    </ScrollViewer>
                  </Border></StackPanel>
              </DataTemplate>
            </ContentControl.ContentTemplate>
          </ContentControl>
        </Expander>
      </Border>

      <!-- Refresh Button -->
      <Border Background="Transparent" Padding="12" Margin="0,8,0,8">
        <Button Content="🔄 Refresh Job Details"
                Command="{Binding RefreshCommand}"
                HorizontalAlignment="Center"
                Background="{DynamicResource ButtonBackgroundBrush}"
                Foreground="{DynamicResource TextForegroundBrush}"
                BorderThickness="0"
                Padding="16,8"
                CornerRadius="18"
                FontSize="13"
                FontWeight="SemiBold"
                Margin="0,0,0,24" />
      </Border>

    </StackPanel>
  </ScrollViewer>

</UserControl>
