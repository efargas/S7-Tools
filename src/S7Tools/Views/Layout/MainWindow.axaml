<Window xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:S7Tools.ViewModels.Layout"
    xmlns:vmSettings="using:S7Tools.ViewModels.Settings"
    xmlns:vmJobs="using:S7Tools.ViewModels.Jobs"
    xmlns:vmTasks="using:S7Tools.ViewModels.Tasks"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:i="using:Avalonia.Xaml.Interactivity"
    xmlns:viewsSettings="clr-namespace:S7Tools.Views.Settings"
    xmlns:viewsJobs="clr-namespace:S7Tools.Views.Jobs"
    xmlns:viewsTasks="clr-namespace:S7Tools.Views.Tasks"
    xmlns:vmProfiles="using:S7Tools.ViewModels.Profiles"
    xmlns:viewsProfiles="clr-namespace:S7Tools.Views.Profiles"
    xmlns:local="clr-namespace:S7Tools"
    xmlns:icons="using:Projektanker.Icons.Avalonia"
    xmlns:converters="clr-namespace:S7Tools.Converters"
    xmlns:vmPages="using:S7Tools.ViewModels.Pages"
    xmlns:viewsPages="clr-namespace:S7Tools.Views.Pages"
    xmlns:ids="clr-namespace:Dock.Avalonia.Controls;assembly=Dock.Avalonia"
    mc:Ignorable="d" d:DesignWidth="1024" d:DesignHeight="768"
    x:Class="S7Tools.Views.Layout.MainWindow"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    Title="S7Tools"
    WindowStartupLocation="CenterScreen"
    Background="{DynamicResource AppBackgroundBrush}">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <Window.Resources>
        <converters:BooleanToInverseBooleanConverter x:Key="BooleanToInverseBooleanConverter" />
        <converters:GridLengthToDoubleConverter x:Key="GridLengthToDoubleConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:BooleanToColorConverter x:Key="BooleanToColorConverter" />

        <!-- DataTemplate for SettingsViewModel in sidebar (categories only) -->
        <DataTemplate x:Key="SettingsSidebarTemplate" DataType="vmSettings:SettingsViewModel">
            <viewsSettings:SettingsCategoriesView />
        </DataTemplate>

        <!-- DataTemplate for SettingsViewModel in main content (content only) -->
        <DataTemplate x:Key="SettingsMainContentTemplate" DataType="vmSettings:SettingsViewModel">
            <viewsSettings:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+B" Command="{Binding Navigation.ToggleSidebarCommand}" />
        <KeyBinding Gesture="Alt+F4" Command="{Binding ExitCommand}" />
        <!-- Activity Bar Navigation -->
        <KeyBinding Gesture="Ctrl+Shift+E"
            Command="{Binding Navigation.NavigateToActivityBarItemCommand}"
            CommandParameter="explorer" />
        <KeyBinding Gesture="Ctrl+Shift+F"
            Command="{Binding Navigation.NavigateToActivityBarItemCommand}"
            CommandParameter="connections" />
        <KeyBinding Gesture="Ctrl+Shift+L"
            Command="{Binding Navigation.NavigateToActivityBarItemCommand}"
            CommandParameter="logviewer" />
        <KeyBinding Gesture="Ctrl+OemComma"
            Command="{Binding Navigation.NavigateToActivityBarItemCommand}"
            CommandParameter="settings" />
    </Window.KeyBindings>

    <!-- VSCode-style layout structure -->
    <DockPanel>
        <!-- Menu Bar -->
        <Menu DockPanel.Dock="Top" Background="{DynamicResource PanelBackgroundBrush}" Foreground="{DynamicResource TextForegroundSecondaryBrush}" Height="40"
            FontSize="14">
            <MenuItem Header="_File" Foreground="{DynamicResource TextForegroundSecondaryBrush}">
                <MenuItem Header="_New File" InputGesture="Ctrl+N" />
                <MenuItem Header="_Load Configuration..." InputGesture="Ctrl+O"
                    Command="{Binding LoadConfigurationCommand}" />
                <MenuItem Header="_Save Configuration" InputGesture="Ctrl+S"
                    Command="{Binding SaveConfigurationCommand}" />
                <MenuItem Header="_Save As..." InputGesture="Ctrl+Shift+S" />
                <Separator />
                <MenuItem Header="_Exit" Command="{Binding ExitCommand}" InputGesture="Alt+F4" />
            </MenuItem>
            <MenuItem Header="_Edit" Foreground="{DynamicResource TextForegroundSecondaryBrush}" StaysOpenOnClick="True">
                <MenuItem Header="_Undo" InputGesture="Ctrl+Z" />
                <MenuItem Header="_Redo" InputGesture="Ctrl+Y" />
                <Separator />
                <MenuItem Header="_Cut" Command="{Binding CutCommand}" InputGesture="Ctrl+X"
                    StaysOpenOnClick="False" />
                <MenuItem Header="_Copy" Command="{Binding CopyCommand}" InputGesture="Ctrl+C"
                    StaysOpenOnClick="False" />
                <MenuItem Header="_Paste" Command="{Binding PasteCommand}" InputGesture="Ctrl+V"
                    StaysOpenOnClick="False" />
                <Separator />
                <MenuItem Header="_Find" InputGesture="Ctrl+F" />
                <MenuItem Header="_Replace" InputGesture="Ctrl+H" />
            </MenuItem>
            <MenuItem Header="_View" Foreground="{DynamicResource TextForegroundSecondaryBrush}">
                <MenuItem Header="_Command Palette..." InputGesture="Ctrl+Shift+P" />
                <MenuItem Header="_Explorer" InputGesture="Ctrl+Shift+E" />
                <MenuItem Header="_Search" InputGesture="Ctrl+Shift+F" />
                <MenuItem Header="Toggle _Sidebar"
                    Command="{Binding Navigation.ToggleSidebarCommand}" InputGesture="Ctrl+B" />
            </MenuItem>
            <MenuItem Header="_Help" Foreground="{DynamicResource TextForegroundSecondaryBrush}">
                <MenuItem Header="_About" />
            </MenuItem>
        </Menu>

        <!-- Status Bar anchored to window bottom -->
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource BrandAccentBrush}" Height="24">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="8,0" Spacing="8">
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextForegroundBrush}"
                        VerticalAlignment="Center" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="8,0" Spacing="8"
                    IsVisible="{Binding Navigation.ShowLogStats}">
                    <TextBlock Text="|" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                    <TextBlock Text="{Binding Navigation.LogStatsMessage}" Foreground="{DynamicResource TextForegroundBrush}"
                        VerticalAlignment="Center" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Margin="8,0" Spacing="8"
                    IsVisible="{Binding LastButtonPressed, Converter={StaticResource BooleanToVisibilityConverter}}">
                    <TextBlock Text="|" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center" FontSize="12" />
                    <TextBlock Text="{Binding LastButtonPressed}" Foreground="{DynamicResource TextForegroundBrush}"
                        VerticalAlignment="Center" FontSize="12" />
                </StackPanel>

                <StackPanel Grid.Column="3" Orientation="Horizontal" Margin="8,0">
                    <TextBlock Text="S7Tools" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center"
                        FontSize="12" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area with Docking -->
        <Grid>
            <Grid.ColumnDefinitions>
                <!-- Activity Bar -->
                <ColumnDefinition Width="48" />
                <!-- Sidebar - Width changes based on visibility -->
                <ColumnDefinition
                    Width="{Binding Navigation.IsSidebarVisible, Converter={x:Static converters:ObjectConverters.SidebarWidthConverter}}" />
                <!-- Sidebar Splitter -->
                <ColumnDefinition Width="Auto" />
                <!-- Main Content (DockControl) -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

                <!-- Activity Bar -->
                <Border Grid.Column="0" Background="{DynamicResource ControlBackgroundBrush}" BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,1,0">
                    <ItemsControl ItemsSource="{Binding Navigation.ActivityBarItems}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="48" Height="48">
                                    <!-- Selection indicator (left border) -->
                                    <Border Width="2"
                                        Height="48"
                                        Background="{DynamicResource BrandAccentBrush}"
                                        HorizontalAlignment="Left"
                                        IsVisible="{Binding IsSelected}" />

                                    <!-- Button -->
                                    <Button Width="48"
                                        Height="48"
                                        Padding="0"
                                        BorderThickness="0"
                                        Background="Transparent"
                                        Command="{Binding $parent[Window].DataContext.Navigation.SelectActivityBarItemCommand}"
                                        CommandParameter="{Binding Id}"
                                        ToolTip.Tip="{Binding Tooltip}"
                                        Name="ActivityBarButton">
                                        <Button.Styles>
                                            <Style Selector="Button">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <Style Selector="Button:pointerover">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <Style Selector="Button:pressed">
                                                <Setter Property="Background" Value="Transparent" />
                                            </Style>
                                            <!-- Icon hover effect via Button hover -->
                                            <Style Selector="Button:pointerover > icons|Icon">
                                                <Setter Property="Foreground" Value="{DynamicResource TextForegroundBrush}" />
                                            </Style>
                                        </Button.Styles>
                                        <icons:Icon Width="40"
                                            Height="40"
                                            Value="{Binding IconPath}"
                                            Foreground="{Binding IsSelected, Converter={StaticResource BooleanToColorConverter}, ConverterParameter='#FFFFFF|#858585'}" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Border>

                <!-- Sidebar -->
                <Border Grid.Column="1"
                    Background="{DynamicResource PanelBackgroundBrush}"
                    BorderBrush="{DynamicResource ControlBorderBrush}"
                    BorderThickness="0,0,1,0"
                    IsVisible="{Binding Navigation.IsSidebarVisible}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- Sidebar Header - Darker background for better hierarchy -->
                        <Border Grid.Row="0"
                            Background="{DynamicResource AppBackgroundBrush}"
                            Height="35"
                            BorderBrush="{DynamicResource ControlBorderBrush}"
                            BorderThickness="0,0,0,1">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0"
                                    Text="{Binding Navigation.SidebarTitle}"
                                    Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    VerticalAlignment="Center"
                                    Margin="12,0" />

                                <Button Grid.Column="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Width="24"
                                    Height="24"
                                    Margin="4"
                                    Command="{Binding Navigation.ToggleSidebarCommand}"
                                    ToolTip.Tip="Collapse Sidebar">
                                    <icons:Icon Value="fa-solid fa-times"
                                        Width="12"
                                        Height="12"
                                        Foreground="{DynamicResource TextForegroundSecondaryBrush}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!-- Sidebar Content -->
                        <ContentControl Grid.Row="1" Content="{Binding Navigation.CurrentContent}">
                            <ContentControl.DataTemplates>
                                <DataTemplate DataType="vmSettings:SettingsViewModel">
                                    <viewsSettings:SettingsCategoriesView />
                                </DataTemplate>
                                <DataTemplate DataType="vmProfiles:ProfilesViewModel">
                                    <viewsProfiles:ProfilesSidebarView />
                                </DataTemplate>
                                <DataTemplate DataType="vmJobs:JobsManagementViewModel">
                                    <viewsJobs:JobsSidebarView />
                                </DataTemplate>
                                <DataTemplate DataType="vm:TaskManagerShellViewModel">
                                    <viewsTasks:TaskManagerSidebarView />
                                </DataTemplate>
                                <DataTemplate DataType="vmPages:MemoryDumpViewerViewModel">
                                    <viewsPages:MemoryDumpSidebarView />
                                </DataTemplate>
                            </ContentControl.DataTemplates>
                        </ContentControl>
                    </Grid>
                </Border>

                <!-- Sidebar GridSplitter -->
                <GridSplitter Grid.Column="2"
                    Width="8"
                    Background="Transparent"
                    VerticalAlignment="Stretch"
                    ResizeDirection="Columns"
                    IsVisible="{Binding Navigation.IsSidebarVisible}"
                    Cursor="SizeWestEast"
                    ShowsPreview="False" />

                <!-- Main Editor Area (DockControl) -->
                <ids:DockControl Grid.Column="3" Layout="{Binding Layout}" />
        </Grid>
    </DockPanel>
</Window>