<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Controls"
             xmlns:converters="using:S7Tools.Converters"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             xmlns:fa="using:FluentAvalonia.UI.Controls"
             mc:Ignorable="d"
             x:Class="S7Tools.Views.Controls.SerialPortDiscoveryControl"
             x:DataType="vm:SerialPortDiscoveryViewModel">

  <UserControl.Styles>
    <StyleInclude Source="/Styles/PropertyStyles.axaml" />
  </UserControl.Styles>

  <Grid RowDefinitions="Auto,*,Auto">
    <!-- Row 0: Header with filters and buttons -->
    <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto">
      <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
        <TextBlock Text="Port Discovery" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" VerticalAlignment="Center" />
        <TextBlock Text="|" Margin="8,0" Foreground="{DynamicResource TextForegroundSecondaryBrush}" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding StatusMessage}" Foreground="{DynamicResource TextForegroundMutedBrush}" VerticalAlignment="Center"/>
      </StackPanel>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
        <!-- Port Type Filters -->
        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding IncludeUsbPorts}" IsEnabled="{Binding CanToggleUsbPorts}"/>
            <TextBlock Text="UsbPorts" Foreground="{DynamicResource TextForegroundSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding IncludeAcmPorts}" IsEnabled="{Binding CanToggleAcmPorts}"/>
            <TextBlock Text="AcmPorts" Foreground="{DynamicResource TextForegroundSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <CheckBox IsChecked="{Binding IncludeSerialPorts}" IsEnabled="{Binding CanToggleSerialPorts}"/>
            <TextBlock Text="StandardPorts" Foreground="{DynamicResource TextForegroundSecondaryBrush}" FontSize="13" VerticalAlignment="Center"/>
          </StackPanel>
        </StackPanel>
        <TextBlock Text="|" Margin="8,0" Foreground="{DynamicResource TextForegroundSecondaryBrush}" VerticalAlignment="Center"/>
        <Button Content="Scan Ports" Command="{Binding ScanPortsCommand}" IsEnabled="{Binding IsScanning, Converter={x:Static converters:BooleanConverters.Not}}"/>
        <Button Content="Stop" Command="{Binding StopScanCommand}" IsEnabled="{Binding IsScanning}"/>
      </StackPanel>
    </Grid>

    <!-- Row 1: Port list with scanning overlay -->
    <Grid Grid.Row="1" Margin="0,12,0,0" Height="140">
      <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <ListBox ItemsSource="{Binding DiscoveredPorts}"
                 SelectedItem="{Binding SelectedPort}"
                 Background="Transparent"
                 Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                 BorderBrush="Transparent"
                 BorderThickness="0"
                 Padding="0">
          <ListBox.ItemsPanel>
            <ItemsPanelTemplate>
              <WrapPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ListBox.ItemsPanel>

          <ListBox.Styles>
            <!-- ListBoxItem container styling -->
            <Style Selector="ListBoxItem">
              <Setter Property="Padding" Value="0" />
              <Setter Property="Margin" Value="0,0,12,12" />
              <Setter Property="Background" Value="Transparent" />
              <Setter Property="BorderThickness" Value="0" />
            </Style>

            <!-- Remove selection background -->
            <Style Selector="ListBoxItem:selected /template/ ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Remove hover background -->
            <Style Selector="ListBoxItem:pointerover /template/ ContentPresenter">
              <Setter Property="Background" Value="Transparent" />
            </Style>

            <!-- Apply hover effect to card border -->
            <Style Selector="ListBoxItem:pointerover Border.PortCard">
              <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
              <Setter Property="BorderThickness" Value="2" />
            </Style>

            <!-- Apply selection effect to card border -->
            <Style Selector="ListBoxItem:selected Border.PortCard">
              <Setter Property="BorderBrush" Value="{DynamicResource BrandAccentBrush}" />
              <Setter Property="BorderThickness" Value="2" />
            </Style>
          </ListBox.Styles>

          <ListBox.ItemTemplate>
            <DataTemplate>
              <Border Classes="PortCard">
                <StackPanel Spacing="6" VerticalAlignment="Center">
                  <!-- Port type badge -->
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-plug"
                                Width="12"
                                Height="12"
                                Foreground="{DynamicResource BrandAccentBrush}"
                                VerticalAlignment="Center" />
                    <TextBlock FontWeight="SemiBold"
                               FontSize="11"
                               Foreground="{DynamicResource BrandAccentBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding PortTypeDisplay}" />
                  </StackPanel>

                  <!-- Port name and status -->
                  <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                    <TextBlock FontSize="12"
                               Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                               VerticalAlignment="Center"
                               Text="{Binding PortName}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="100" />
                    <Border Background="{DynamicResource ButtonBackgroundBrush}"
                            CornerRadius="2"
                            Padding="4,2"
                            VerticalAlignment="Center"
                            IsVisible="{Binding IsAccessible}">
                      <TextBlock Text="OK"
                                 FontSize="9"
                                 Foreground="{DynamicResource TextForegroundBrush}"
                                 VerticalAlignment="Center"/>
                    </Border>
                  </StackPanel>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </ScrollViewer>

      <!-- Scanning overlay -->
      <Border Background="{DynamicResource AppBackgroundBrush}"
              Opacity="0.45"
              IsVisible="{Binding IsScanning}"
              HorizontalAlignment="Stretch"
              VerticalAlignment="Stretch">
        <fa:ProgressRing Width="64"
                         Height="64"
                         IsActive="{Binding IsScanning}" />
      </Border>
    </Grid>

    <!-- Row 2: Footer with statistics -->
    <StackPanel Grid.Row="2"
                Orientation="Horizontal"
                Spacing="8"
                HorizontalAlignment="Right"
                Margin="0,6,0,0">
      <TextBlock Text="Found:" Foreground="{DynamicResource TextForegroundSecondaryBrush}" FontSize="13"/>
      <TextBlock Text="{Binding TotalPortsFound}" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" FontSize="13"/>
      <TextBlock Text="," Foreground="{DynamicResource TextForegroundSecondaryBrush}" FontSize="13"/>
      <TextBlock Text="Accessible:" Foreground="{DynamicResource TextForegroundSecondaryBrush}" FontSize="13"/>
      <TextBlock Text="{Binding AccessiblePortsCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextForegroundBrush}" FontSize="13"/>
    </StackPanel>
  </Grid>

</UserControl>
