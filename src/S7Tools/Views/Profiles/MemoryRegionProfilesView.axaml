<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.Profiles"
             xmlns:conv="using:S7Tools.Converters"
             xmlns:icons="using:Projektanker.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="S7Tools.Views.Profiles.MemoryRegionProfilesView"
             x:DataType="vm:MemoryRegionProfilesViewModel"
             Background="{DynamicResource AppBackgroundBrush}">

  <UserControl.Resources>
    <conv:BooleanToInverseBooleanConverter x:Key="InvBool" />
  </UserControl.Resources>

  <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="20" Spacing="12">
      <!-- Header -->
      <TextBlock Text="Memory Region Profiles"
                 FontSize="24"
                 FontWeight="Bold"
                 Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                 Margin="0,0,0,10" />

      <!-- Profile Management Section -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-memory" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="PROFILE MANAGEMENT" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <!-- Toolbar above the DataGrid -->
            <Grid Margin="0,0,0,8">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                <Button Width="110" Height="34" Command="{Binding CreateCommand}" Background="#28A745" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-plus" Width="14" Height="14" />
                    <TextBlock Text="Create" />
                  </StackPanel>
                </Button>

                <Button Width="110" Height="34" Command="{Binding EditCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-edit" Width="14" Height="14" />
                    <TextBlock Text="Edit" />
                  </StackPanel>
                </Button>

                <Button Width="110" Height="34" Command="{Binding DuplicateCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:Icon Value="fa-solid fa-copy" Width="14" Height="14" />
                    <TextBlock Text="Duplicate" />
                  </StackPanel>
                </Button>

                <Button Width="110" Height="34" Command="{Binding SetDefaultCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:Icon Value="fa-solid fa-star" Width="14" Height="14" />
                    <TextBlock Text="Set Default" />
                  </StackPanel>
                </Button>

                <Button Width="110" Height="34" Command="{Binding DeleteCommand}" Background="#D13438" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:Icon Value="fa-solid fa-trash" Width="14" Height="14" />
                    <TextBlock Text="Delete" />
                  </StackPanel>
                </Button>

                <Button Width="110" Height="34" Command="{Binding RefreshCommand}" Background="Transparent" BorderBrush="{DynamicResource ControlBorderBrush}" Foreground="{DynamicResource TextForegroundSecondaryBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <icons:Icon Value="fa-solid fa-sync" Width="14" Height="14" />
                    <TextBlock Text="Refresh" />
                  </StackPanel>
                </Button>
              </StackPanel>

              <!-- Import/Export Buttons -->
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                <Button Width="110" Height="34" Command="{Binding ExportProfilesCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-download" Width="14" Height="14" />
                    <TextBlock Text="Export" />
                  </StackPanel>
                </Button>

                <Button Width="110" Height="34" Command="{Binding ImportProfilesCommand}" Background="{DynamicResource ButtonBackgroundBrush}" Foreground="{DynamicResource TextForegroundBrush}">
                  <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <icons:Icon Value="fa-solid fa-upload" Width="14" Height="14" />
                    <TextBlock Text="Import" />
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>

            <!-- DataGrid -->
            <DataGrid ItemsSource="{Binding Profiles}"
                      SelectedItem="{Binding SelectedProfile}"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      MaxHeight="400"
                      Margin="0,0,0,8">
              <DataGrid.Styles>
                <Style Selector="DataGridColumnHeader">
                  <Setter Property="FontSize" Value="11" />
                  <Setter Property="FontWeight" Value="SemiBold" />
                  <Setter Property="Padding" Value="8,4,32,4" />
                  <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                  <Setter Property="Template">
                    <ControlTemplate>
                      <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}">
                        <DockPanel>
                          <ContentPresenter Content="{TemplateBinding Content}"
                                            DockPanel.Dock="Left"
                                            VerticalAlignment="Center" />
                        </DockPanel>
                      </Border>
                    </ControlTemplate>
                  </Setter>
                </Style>
              </DataGrid.Styles>

              <DataGrid.Columns>
                <DataGridTextColumn Binding="{Binding Id}" Width="60" MinWidth="50">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="ID" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Name}" Width="200" MinWidth="120">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Name" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Description}" Width="250" MinWidth="140">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Description" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding SegmentCount}" Width="100" MinWidth="80">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Segments" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Width="120" MinWidth="100">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Selected" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridTextColumn.Header>
                  <DataGridTextColumn.Binding>
                    <MultiBinding StringFormat="{}{0}/{1}">
                      <Binding Path="Segments" Converter="{x:Static conv:CollectionConverters.CountSelectedSegments}" />
                      <Binding Path="Segments.Count" />
                    </MultiBinding>
                  </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridCheckBoxColumn Binding="{Binding IsActive}" Width="80" MinWidth="60" IsReadOnly="True">
                  <DataGridCheckBoxColumn.Header>
                    <TextBlock Text="Active" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>

                <DataGridCheckBoxColumn Binding="{Binding IsDefault}" Width="80" MinWidth="60" IsReadOnly="True">
                  <DataGridCheckBoxColumn.Header>
                    <TextBlock Text="Default" Margin="0,0,8,0" TextTrimming="CharacterEllipsis" />
                  </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>

              </DataGrid.Columns>
            </DataGrid>

            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0"
                         Text="{Binding Profiles.Count, StringFormat='Total Profiles: {0}'}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="12" />

              <TextBlock Grid.Column="1"
                         Text="{Binding StatusMessage}"
                         Foreground="{DynamicResource TextForegroundMutedBrush}"
                         FontSize="12" />
            </Grid>
          </StackPanel>
        </Expander>
      </Border>

      <!-- Selected Profile Details Section -->
      <Border Classes="ProfileSection" Background="{DynamicResource PanelBackgroundBrush}"
              IsVisible="{Binding SelectedProfile, Converter={x:Static ObjectConverters.IsNotNull}}">
        <Expander IsExpanded="True">
          <Expander.Header>
            <Grid Background="Transparent" Height="38" Margin="4,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <icons:Icon Grid.Column="0" Classes="ExpanderIcon ExpanderArrow" />
              <icons:Icon Grid.Column="1" Classes="ExpanderIcon" Value="fa-solid fa-info-circle" />
              <TextBlock Grid.Column="2" Classes="ExpanderHeader" Text="SELECTED PROFILE DETAILS" />
            </Grid>
          </Expander.Header>

          <StackPanel Spacing="8" Margin="24,16,24,24">
            <Grid ColumnDefinitions="Auto,*,Auto,Auto" RowDefinitions="Auto,Auto,Auto" RowSpacing="4">
              <!-- Row 0: Name -->
              <TextBlock Grid.Row="0" Grid.Column="0" Text="Name:" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}" Margin="0,0,8,0" />
              <TextBlock Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding SelectedProfile.Name}"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}" />

              <!-- Row 1: Description (wraps when long) -->
              <TextBlock Grid.Row="1" Grid.Column="0" Text="Description:" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}" Margin="0,4,8,0"
                         VerticalAlignment="Top" />
              <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="3"
                         Text="{Binding SelectedProfile.Description}"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                         TextWrapping="Wrap" Margin="0,4,0,0" />

              <!-- Row 2: Total Segments | Selected (same row) -->
              <TextBlock Grid.Row="2" Grid.Column="0" Text="Total Segments:" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}" Margin="0,4,8,0" />
              <TextBlock Grid.Row="2" Grid.Column="1"
                         Text="{Binding SelectedProfile.SegmentCount}"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}" Margin="0,4,16,0" />
              <TextBlock Grid.Row="2" Grid.Column="2" Text="Selected:" FontWeight="SemiBold"
                         Foreground="{DynamicResource TextForegroundSecondaryBrush}" Margin="8,4,8,0" />
              <TextBlock Grid.Row="2" Grid.Column="3" Foreground="{DynamicResource TextForegroundSecondaryBrush}" Margin="0,4,0,0">
                <TextBlock.Text>
                  <MultiBinding StringFormat="{}{0} of {1} segments">
                    <Binding Path="SelectedProfile.Segments" Converter="{x:Static conv:CollectionConverters.CountSelectedSegments}" />
                    <Binding Path="SelectedProfile.Segments.Count" />
                  </MultiBinding>
                </TextBlock.Text>
              </TextBlock>
            </Grid>

            <!-- Memory Segments List -->
            <TextBlock Text="Memory Segments"
                       FontSize="14"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                       Margin="0,8,0,4" />

            <DataGrid ItemsSource="{Binding SelectedProfile.Segments}"
                      Background="{DynamicResource ControlBackgroundBrush}"
                      Foreground="{DynamicResource TextForegroundSecondaryBrush}"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      CanUserReorderColumns="False"
                      CanUserResizeColumns="True"
                      CanUserSortColumns="True"
                      IsReadOnly="True"
                      MaxHeight="150"
                      Margin="0,0,0,8">
              <DataGrid.Columns>
                <DataGridCheckBoxColumn Binding="{Binding IsSelected}" Width="60" IsReadOnly="True">
                  <DataGridCheckBoxColumn.Header>
                    <TextBlock Text="Selected" FontSize="11" />
                  </DataGridCheckBoxColumn.Header>
                </DataGridCheckBoxColumn>

                <DataGridTextColumn Binding="{Binding Name}" Width="120" MinWidth="80">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Name" FontSize="11" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding StartAddress}" Width="120" MinWidth="100">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Start Address" FontSize="11" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Width="100" MinWidth="80">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Size" FontSize="11" />
                  </DataGridTextColumn.Header>
                  <DataGridTextColumn.Binding>
                    <Binding Path="Size" Mode="OneWay" Converter="{x:Static conv:ByteSizeConverter.Instance}" />
                  </DataGridTextColumn.Binding>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Type}" Width="80" MinWidth="60">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Type" FontSize="11" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>

                <DataGridTextColumn Binding="{Binding Description}" Width="250" MinWidth="120">
                  <DataGridTextColumn.Header>
                    <TextBlock Text="Description" FontSize="11" />
                  </DataGridTextColumn.Header>
                </DataGridTextColumn>
              </DataGrid.Columns>
            </DataGrid>
          </StackPanel>
        </Expander>
      </Border>
    </StackPanel>
  </ScrollViewer>
</UserControl>
