<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="using:S7Tools.ViewModels.[CATEGORY]"
             xmlns:views="using:S7Tools.Views.[CATEGORY]"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="650"
             x:Class="S7Tools.Views.[CATEGORY].[FEATURE_NAME]MainView"
             x:DataType="vm:[FEATURE_NAME]ViewModel"
             Background="#1E1E1E">

  <Design.DataContext>
    <vm:[FEATURE_NAME]ViewModel/>
  </Design.DataContext>

  <!-- Content switching based on sidebar selection -->
  <!-- ViewLocator automatically maps ViewModels to Views -->
  <ContentControl Content="{Binding SelectedContentViewModel}" />
  
  <!-- Alternative: Manual switching with explicit DataTemplates -->
  <!--
  <ContentControl Content="{Binding SelectedContentViewModel}">
    <ContentControl.DataTemplates>
      <DataTemplate DataType="vm:[FEATURE_NAME]OverviewViewModel">
        <views:[FEATURE_NAME]OverviewView />
      </DataTemplate>
      <DataTemplate DataType="vm:[FEATURE_NAME]DetailsViewModel">
        <views:[FEATURE_NAME]DetailsView />
      </DataTemplate>
      <DataTemplate DataType="vm:[FEATURE_NAME]SettingsViewModel">
        <views:[FEATURE_NAME]SettingsView />
      </DataTemplate>
    </ContentControl.DataTemplates>
  </ContentControl>
  -->
</UserControl>
